<div class="card border-0 shadow-sm" style="max-width: 680px;">
  <div class="card-header bg-white fw-bold">
    Create Ticket On Behalf of a Customer
  </div>
  <div class="card-body">

    <div class="alert alert-info py-2 mb-4" style="font-size:13px;">
      This ticket will be registered under the selected customer.
      It will be <strong>auto-assigned to you</strong>.
    </div>

    <%= form_with model: @ticket, url: on_behalf_path, local: true do |f| %>

      <div class="mb-3">
        <%= label_tag :customer_id, "Customer", class: "form-label fw-bold" %>
        <%= select_tag "ticket[customer_id]",
            options_from_collection_for_select(@customers, :id, :fullname),
            class: "form-select",
            prompt: "Select a customer" %>
        <div class="form-text text-muted">Who is this ticket for?</div>
      </div>

      <div class="mb-3">
        <%= f.label :ticket_type, "Ticket Type", class: "form-label fw-bold" %>
        <%= f.select :ticket_type,
            Ticket::TICKET_TYPES.map { |t| [t.humanize, t] },
            { prompt: "Select a type" },
            class: "form-select" %>
      </div>

      <div class="mb-3">
        <%= f.label :title, "Title", class: "form-label fw-bold" %>
        <%= f.text_field :title,
            class: "form-control",
            placeholder: "Short summary of the issue" %>
        <div class="form-text text-muted">
          Will be saved as: "On behalf of {customer} — {title}"
        </div>
      </div>

      <div class="mb-4">
        <%= f.label :location_id, "Location", class: "form-label fw-bold" %>
        <%= f.collection_select :location_id,
            Location.active.ordered, :id, :name,
            { prompt: "Select location" },
            class: "form-select" %>
      </div>

      <div class="d-flex gap-2">
        <%= f.submit "Submit On Behalf", class: "btn btn-primary" %>
        <%= link_to "Cancel", tickets_path, class: "btn btn-outline-secondary" %>
      </div>

    <% end %>
  </div>
</div>
