<h4 class="mb-4" style="font-family: Poppins;">My Support Tickets</h4>

<!-- Stat Cards -->
<div class="row g-3 mb-4">

  <div class="col-md-4">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="text-muted" style="font-size:13px;">Total Submitted</div>
        <div class="fs-3 fw-bold"><%= @my_tickets.count %></div>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="text-muted" style="font-size:13px;">Open</div>
        <div class="fs-3 fw-bold text-primary"><%= @open_tickets %></div>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="text-muted" style="font-size:13px;">Closed</div>
        <div class="fs-3 fw-bold text-success"><%= @closed_tickets %></div>
      </div>
    </div>
  </div>

</div>

<!-- Unread Notifications Banner -->
<% if @notifications.any? %>
  <div class="alert alert-info d-flex justify-content-between align-items-center">
    <span>You have <strong><%= @notifications.count %></strong> unread notification(s).</span>
    <%= link_to "View", ticket_notifications_path, class: "btn btn-sm btn-info" %>
  </div>
<% end %>

<!-- Tickets Table -->
<div class="card border-0 shadow-sm">
  <div class="card-header bg-white d-flex justify-content-between align-items-center">
    <span class="fw-bold">My Tickets</span>
    <%= link_to "+ New Ticket", new_ticket_path, class: "btn btn-sm btn-primary" %>
  </div>
  <div class="card-body p-0">
    <table class="table table-hover mb-0">
      <thead class="table-light">
        <tr>
          <th>#</th>
          <th>Title</th>
          <th>Type</th>
          <th>Status</th>
          <th>Assigned To</th>
          <th>Created</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @my_tickets.each do |ticket| %>
          <tr>
            <td><%= ticket.id %></td>
            <td><%= ticket.title %></td>
            <td><span class="badge bg-secondary"><%= ticket.ticket_type.humanize %></span></td>
            <td>
              <% color = { "open" => "primary", "in_progress" => "warning", "closed" => "success", "cancelled" => "danger" } %>
              <span class="badge bg-<%= color[ticket.status] %>"><%= ticket.status.humanize %></span>
            </td>
            <td><%= ticket.assignee&.fullname || "<span class='text-muted'>Pending</span>".html_safe %></td>
            <td><%= ticket.created_at.strftime("%b %d, %Y") %></td>
            <td><%= link_to "View", ticket_path(ticket), class: "btn btn-sm btn-outline-secondary" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
