:css
  .ntb-wrapper {
    max-width: 860px;
    margin: 0 auto;
  }
  .new-ticket-btn {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 24px 28px;
    background: #ffffff;
    border: 1px solid #e0e4ea;
    border-radius: 12px;
    text-decoration: none;
    color: #1a1a1a;
    transition: box-shadow 0.18s, border-color 0.18s;
  }
  .new-ticket-btn:hover {
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    border-color: #0077b6;
    color: #1a1a1a;
  }
  .ntb-icon {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #deeaf5;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .ntb-icon i { font-size: 26px; color: #1b4f72; }
  .ntb-body { flex: 1; }
  .ntb-title { font-size: 17px; font-weight: 700; color: #1a1a1a; margin-bottom: 4px; }
  .ntb-desc  { font-size: 14px; color: #555; line-height: 1.5; }
  .ntb-chevron { font-size: 26px; color: #1a1a1a; flex-shrink: 0; }

.ntb-wrapper
  = link_to catalogue_tickets_path, class: "new-ticket-btn" do
    .ntb-icon
      %i.bi.bi-ticket-perforated-fill
    .ntb-body
      .ntb-title Create A New Ticket
      .ntb-desc Fill out a form for something specific or give us a brief description of your issue
    %i.bi.bi-chevron-right.ntb-chevron
