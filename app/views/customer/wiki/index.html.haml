:css
  .wiki-coming-soon {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    text-align: center;
    gap: 24px;
  }

  .wiki-icon-wrap {
    position: relative;
    width: 100px;
    height: 100px;
  }

  .wiki-icon-wrap i {
    font-size: 56px;
    color: #0077b6;
    position: relative;
    z-index: 1;
    animation: float 3s ease-in-out infinite;
  }

  .wiki-pulse {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: rgba(0, 119, 182, 0.12);
    animation: pulse-ring 2s ease-out infinite;
  }

  .wiki-pulse:nth-child(2) {
    animation-delay: 0.6s;
  }

  .wiki-pulse:nth-child(3) {
    animation-delay: 1.2s;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-10px); }
  }

  @keyframes pulse-ring {
    0%   { transform: scale(0.6); opacity: 0.7; }
    100% { transform: scale(1.8); opacity: 0; }
  }

  .wiki-title {
    font-family: Poppins, sans-serif;
    font-size: 28px;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0;
  }

  .wiki-subtitle {
    font-size: 15px;
    color: #6b7280;
    max-width: 380px;
    margin: 0;
    line-height: 1.6;
  }

  .wiki-dots {
    display: flex;
    gap: 8px;
    margin-top: 8px;
  }

  .wiki-dots span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #0077b6;
    animation: dot-bounce 1.4s ease-in-out infinite;
  }

  .wiki-dots span:nth-child(2) { animation-delay: 0.2s; }
  .wiki-dots span:nth-child(3) { animation-delay: 0.4s; }

  @keyframes dot-bounce {
    0%, 80%, 100% { transform: scale(0.7); opacity: 0.4; }
    40%           { transform: scale(1.2); opacity: 1; }
  }

.wiki-coming-soon
  .wiki-icon-wrap
    .wiki-pulse
    .wiki-pulse
    .wiki-pulse
    %i.bi.bi-journal-bookmark-fill

  %h3.wiki-title Coming Soon
  %p.wiki-subtitle
    We're building something great.
    The Wiki will be your go-to resource for guides, policies, and documentation.

  .wiki-dots
    %span
    %span
    %span
