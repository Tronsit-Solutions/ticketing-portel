.d-flex.justify-content-between.align-items-center.mb-4
  %h4.mb-0{style: "font-family: Poppins;"}
    - if @report == "agent_detail"
      = "#{@agent.fullname}'s Report"
    - elsif @report == "agents"
      Agent Reports
    - else
      Ticket Reports
  = link_to "#{request.path}.csv?#{request.query_parameters.to_query}", class: "btn btn-success btn-sm" do
    %i.bi.bi-download.me-1
    Download CSV

/ Report Tabs
%ul.nav.nav-tabs.mb-4
  %li.nav-item
    = link_to "Tickets", request.path, class: "nav-link #{"active" if @report == "tickets"}"
  %li.nav-item
    = link_to "Agents", "#{request.path}?report=agents", class: "nav-link #{"active" if @report == "agents"}"
  - if @report == "agent_detail"
    %li.nav-item
      %span.nav-link.active= @agent.fullname

- if @report == "agent_detail"
  = link_to "#{request.path}?report=agents", class: "d-inline-flex align-items-center text-decoration-none mb-3" do
    %i.bi.bi-arrow-left.me-1
    Back to Agents

  = render "agent_detail_card", agent: @agent
  = render "tickets_filters"
  = render "tickets_table"

- elsif @report == "agents"
  / Filters
  - active_filters = params.slice(:team_id, :agent_status, :search, :joined_start_date, :joined_end_date).values.any?(&:present?)
  .card.filter-bar.border-0.shadow-sm.mb-4
    .card-body.py-2
      = form_with url: request.path, method: :get, local: true, class: "row g-2 align-items-end", data: { controller: "auto-submit", action: "change->auto-submit#submit" } do |f|
        = hidden_field_tag :report, "agents"
        .col-md-2
          = label_tag :search, "Search", class: "form-label mb-1 fw-bold"
          = text_field_tag :search, params[:search], class: "form-control form-control-sm", placeholder: "Name or email"
        .col-md-2
          = label_tag :team_id, "Team", class: "form-label mb-1 fw-bold"
          = select_tag :team_id, options_for_select([["All Teams", ""]] + @teams.map { |t| [t.name, t.id] }, params[:team_id]), class: "form-select form-select-sm"
        .col-md-2
          = label_tag :agent_status, "Status", class: "form-label mb-1 fw-bold"
          = select_tag :agent_status, options_for_select([["All", ""], ["Active", "true"], ["Inactive", "false"]], params[:agent_status]), class: "form-select form-select-sm"
        .col-md-2
          = label_tag :joined_start_date, "Joined From", class: "form-label mb-1 fw-bold"
          = date_field_tag :joined_start_date, params[:joined_start_date], class: "form-control form-control-sm"
        .col-md-2
          = label_tag :joined_end_date, "Joined To", class: "form-label mb-1 fw-bold"
          = date_field_tag :joined_end_date, params[:joined_end_date], class: "form-control form-control-sm"
        - if active_filters
          .col-md-2
            = link_to "#{request.path}?report=agents", class: "btn btn-outline-secondary btn-sm w-100" do
              %i.bi.bi-x-circle.me-1
              Clear Filters

  / Report Table
  .card.border-0.shadow-sm
    .card-body.p-0
      - if @agents.any?
        %table.table.table-hover.mb-0
          %thead.table-light
            %tr
              %th.text-center{style: "width: 20%;"} Agent
              %th{style: "width: 15%;"} Team
              %th{style: "width: 9%;"} Status
              %th{style: "width: 15%;"} Joining Date
              %th{style: "width: 10%;"} Open
              %th{style: "width: 10%;"} Closed
              %th{style: "width: 10%;"} Total
              %th.text-center{style: "width: 11%;"} Report
          %tbody
            - @agents.each do |agent|
              %tr
                %td.text-center
                  %span.tooltip-wrap{data: {tooltip: agent.email}}
                    %span.text-truncate-cell= agent.fullname
                %td= agent.team&.name || "-"
                %td
                  %span{class: "badge bg-#{agent.is_active? ? "success" : "secondary"}"}= agent.is_active? ? "Active" : "Inactive"
                %td{style: "font-size:13px;"}= agent.created_at.strftime("%b %d, %Y")
                - stats = agent.ticket_stats
                %td= stats[:open]
                %td= stats[:closed]
                %td= stats[:total]
                %td.text-center
                  = link_to "#{request.path}?report=agent_detail&agent_id=#{agent.id}", class: "btn btn-outline-primary btn-sm", title: "View #{agent.fullname}'s report" do
                    %i.bi.bi-eye
      - else
        .text-center.text-muted.py-5
          %i.bi.bi-file-earmark-bar-graph{style: "font-size: 2rem;"}
          %p.mt-2 No agents found for the selected filters.

  - if @agents.total_pages > 1
    .d-flex.justify-content-between.align-items-center.mt-3.px-1
      %small.text-muted
        Showing
        %strong= @agents.offset_value + 1
        –
        %strong= [@agents.offset_value + @agents.limit_value, @agents.total_count].min
        of
        %strong= @agents.total_count
        agents
      = paginate @agents

- else
  = render "tickets_filters"
  = render "tickets_table"
