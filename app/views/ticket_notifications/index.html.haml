:css
  .notif-wrap {
    max-width: 1100px;
    margin: 0 auto;
  }
  .notif-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }
  .notif-header h4 {
    font-family: Poppins, sans-serif;
    font-size: 22px;
    font-weight: 700;
    margin: 0;
  }
  .notif-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    overflow: hidden;
  }
  .notif-row {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 18px 24px;
    border-bottom: 1px solid #f0f0f0;
    width: 100%;
    background: none;
    border-left: none;
    border-right: none;
    border-top: none;
    text-align: left;
    cursor: pointer;
    transition: background 0.15s;
  }
  .notif-row:last-child { border-bottom: none; }
  .notif-row.unread { background: #f5f9fd; }
  .notif-row:hover { background: #eef6fc; }
  .notif-avatar-link {
    flex-shrink: 0;
    display: block;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    overflow: hidden;
  }
  .notif-avatar-img {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #1b4f72;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .notif-avatar-img i { font-size: 26px; color: #ffffff; }
  .notif-body { flex: 1; min-width: 0; }
  .notif-text {
    font-size: 14px;
    color: #1a1a1a;
    margin-bottom: 2px;
  }
  .notif-text strong { font-weight: 700; }
  .notif-meta {
    font-size: 12px;
    color: #6b7280;
  }
  .notif-meta .notif-date { color: #0077b6; font-weight: 500; }
  .notif-badge {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #0077b6;
  }
  .empty-state {
    text-align: center;
    padding: 48px 24px;
    color: #9ca3af;
  }
  .empty-state i { font-size: 2.5rem; }
  .empty-state p { margin-top: 12px; font-size: 14px; }

= turbo_stream_from current_user, :ticket_notifications

.notif-wrap
  .notif-header
    %h4 Notifications
    #notif-mark-all-wrap
      - if @notifications.any?(&:unread?)
        = button_to "Mark All as Read",
          mark_all_read_ticket_notifications_path,
          method: :patch,
          class: "btn btn-sm btn-outline-secondary"

  .notif-card
    - if @notifications.any?
      #notif-list
        - @notifications.each do |notification|
          = render "ticket_notifications/notification", notification: notification
    - else
      #notif-list.empty-state
        %i.bi.bi-bell-slash
        %p No notifications yet.

  - if @notifications.any?
    .notif-pagination.mt-3.d-flex.justify-content-center
      = paginate @notifications
