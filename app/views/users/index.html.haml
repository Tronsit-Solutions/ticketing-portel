.d-flex.justify-content-between.align-items-center.mb-4
  %h4.mb-0{:style => "font-family: Poppins;"} Users
  = link_to "+ Add User", new_user_path, class: "btn btn-primary btn-sm"
/ Filters
.card.border-0.shadow-sm.mb-4
  .card-body.py-2
    = form_with url: users_path, method: :get, local: true, class: "row g-2 align-items-end" do |f|
      .col-md-3
        = label_tag :role, "Role", class: "form-label mb-1 fw-bold"
        = select_tag :role,                                                                                                |
          options_for_select(                                                                                              |
            [["All Roles", ""], ["Admin", "admin"], ["Agent", "agent"], ["Manager", "manager"], ["Customer", "customer"]], |
            params[:role]                                                                                                  |
          ),                                                                                                               |
          class: "form-select form-select-sm"                                                                              |
      .col-md-3
        = label_tag :active, "Status", class: "form-label mb-1 fw-bold"
        = select_tag :active,                                         |
          options_for_select(                                         |
            [["All", ""], ["Active", "true"], ["Inactive", "false"]], |
            params[:active]                                           |
          ),                                                          |
          class: "form-select form-select-sm"                         |
      .col-md-2
        = f.submit "Filter", class: "btn btn-outline-primary btn-sm"
      .col-md-2
        = link_to "Clear", users_path, class: "btn btn-outline-secondary btn-sm"
/ Users Table
.card.border-0.shadow-sm
  .card-body.p-0
    %table.table.table-hover.mb-0
      %thead.table-light
        %tr
          %th Name
          %th Email
          %th Role
          %th Team
          %th Status
          %th Joined
          %th
      %tbody
        - @users.each do |user|
          %tr
            %td
              = user.fullname
            %td.text-muted{:style => "font-size:13px;"}
              = user.email
            %td.text-muted{:style => "font-size:13px;"}
              = user.role.humanize
            %td.text-muted{:style => "font-size:13px;"}
              = user.team&.name || "-"
            %td
              - if user.is_active?
                %span.badge.bg-success Active
              - else
                %span.badge.bg-secondary Inactive
            %td{:style => "font-size:13px;"}= user.created_at.strftime("%b %d, %Y")
            %td.d-flex.gap-1
              = link_to "View", user_path(user), class: "btn btn-sm btn-outline-secondary"
              = link_to "Edit", edit_user_path(user), class: "btn btn-sm btn-outline-primary"
              - if user.is_active? && user != current_user
                = button_to "Deactivate",                          |
                  deactivate_user_path(user),                      |
                  method: :patch,                                  |
                  class: "btn btn-sm btn-outline-danger",          |
                  data: { turbo_confirm: "Deactivate this user?" } |

- if @users.total_pages > 1
  .d-flex.justify-content-between.align-items-center.mt-3.px-1
    %small.text-muted
      Showing
      %strong= @users.offset_value + 1
      –
      %strong= [@users.offset_value + @users.limit_value, @users.total_count].min
      of
      %strong= @users.total_count
      users
    = paginate @users
