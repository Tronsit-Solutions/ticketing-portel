= form_with model: user, local: true do |f|
  - if user.errors.any?
    .alert.alert-danger
      %ul.mb-0
        - user.errors.full_messages.each do |msg|
          %li{:style => "font-size:13px;"}= msg
  .mb-3
    = f.label :fullname, "Full Name", class: "form-label fw-bold"
    = f.text_field :fullname, class: "form-control", placeholder: "Full name"
  .mb-3
    = f.label :email, class: "form-label fw-bold"
    = f.email_field :email, class: "form-control", placeholder: "Email address"
  - if user.new_record?
    .mb-3
      = f.label :password, class: "form-label fw-bold"
      = f.password_field :password, class: "form-control", placeholder: "Password"
    .mb-3
      = f.label :password_confirmation, "Confirm Password", class: "form-label fw-bold"
      = f.password_field :password_confirmation, class: "form-control", placeholder: "Confirm password"
  .row
    .col-md-6.mb-3
      = f.label :role, class: "form-label fw-bold"
      = f.select :role,                                              |
        User::ROLES.map { |r| [r.humanize, r] }.sort_by(&:first),    |
        { prompt: "Select role" },                                   |
        class: "form-select"                                         |
    .col-md-6.mb-3
      = f.label :team_id, "Team", class: "form-label fw-bold"
      = f.collection_select :team_id, |
        Team.ordered, :id, :name,     |
        { prompt: "No team" },        |
        class: "form-select"          |
  .mb-3
    = f.label :contact_no, "Contact Number", class: "form-label fw-bold"
    = f.text_field :contact_no, class: "form-control", placeholder: "Contact number"
  .mb-3
    = f.label :address, class: "form-label fw-bold"
    = f.text_area :address, rows: 2, class: "form-control", placeholder: "Address"
  .form-check.mb-4
    = f.check_box :is_active, class: "form-check-input"
    = f.label :is_active, "Active account", class: "form-check-label"
  .d-flex.gap-2
    = f.submit user.new_record? ? "Create User" : "Save Changes", class: "btn btn-primary"
    = link_to "Cancel", users_path, class: "btn btn-outline-secondary"
