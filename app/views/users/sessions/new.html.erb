<!DOCTYPE html>
<html>
  <head>
    <title>Login | Ticketing Portal</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <style>
      body {
        background: linear-gradient(135deg, #0077b6, #023e8a);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Poppins', sans-serif;
      }
      .login-card {
        background: #fff;
        border-radius: 16px;
        padding: 40px;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.2);
      }
      .login-title {
        font-size: 22px;
        font-weight: 700;
        color: #0077b6;
        margin-bottom: 6px;
      }
      .login-subtitle {
        font-size: 13px;
        color: #aaa;
        margin-bottom: 28px;
      }
      .form-control:focus {
        border-color: #0077b6;
        box-shadow: 0 0 0 0.2rem rgba(0,119,182,0.15);
      }
      .btn-login {
        background-color: #0077b6;
        color: #fff;
        width: 100%;
        padding: 10px;
        border: none;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 600;
      }
      .btn-login:hover {
        background-color: #005f99;
        color: #fff;
      }
    </style>
  </head>
  <body>
    <div class="login-card">

      <div class="login-title">Ticketing Portal</div>
      <div class="login-subtitle">Sign in to your account</div>

      <% if flash[:alert] %>
        <div class="alert alert-danger py-2" style="font-size:13px;">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

        <div class="mb-3">
          <%= f.label :email, class: "form-label fw-bold" %>
          <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email",
              class: "form-control",
              placeholder: "Enter your email" %>
        </div>

        <div class="mb-3">
          <%= f.label :password, class: "form-label fw-bold" %>
          <%= f.password_field :password,
              autocomplete: "current-password",
              class: "form-control",
              placeholder: "Enter your password" %>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-4">
          <div class="form-check">
            <%= f.check_box :remember_me, class: "form-check-input" %>
            <%= f.label :remember_me, class: "form-check-label text-muted", style: "font-size:13px;" %>
          </div>
          <% if devise_mapping.recoverable? && controller_name != 'passwords' %>
            <%= link_to "Forgot password?",
                new_password_path(resource_name),
                style: "font-size:13px; color:#0077b6;" %>
          <% end %>
        </div>

        <%= f.submit "Sign In", class: "btn-login" %>

      <% end %>

    </div>
  </body>
</html>
