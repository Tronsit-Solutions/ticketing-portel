!!!
%html
  %head
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %title Login | Ticketing Portal
    %meta{:content => "width=device-width, initial-scale=1", :name => "viewport"}/
    = csrf_meta_tags
    %meta{name: "turbo-cache-control", content: "no-cache"}/
    = stylesheet_link_tag "application", "data-turbo-track": "reload"
    %link{:href => "https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css", :rel => "stylesheet"}/
    = javascript_importmap_tags
    :css
      body {
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-color: #c8763a;
        min-height: 100vh;
        height: 100vh;
        margin: 0;
        padding: 0;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      }

      .login-card {
        background: #fff;
        border-radius: 16px;
        padding: 40px 36px 36px;
        width: 100%;
        max-width: 380px;
        box-shadow: 0 8px 40px rgba(0,0,0,0.18);
        text-align: center;
      }

      .avatar-circle {
        width: 64px;
        height: 64px;
        background-color: #3d8ef8;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
      }

      .avatar-circle i {
        font-size: 30px;
        color: #fff;
      }

      .login-title {
        font-size: 20px;
        font-weight: 600;
        color: #1a1a1a;
        margin-bottom: 24px;
      }

      .form-control {
        border-radius: 8px;
        border: 1.5px solid #ddd;
        padding: 10px 14px;
        font-size: 14px;
        color: #333;
      }

      .form-control::placeholder {
        color: #aaa;
      }

      .form-control:focus {
        border-color: #3d8ef8;
        box-shadow: 0 0 0 3px rgba(61,142,248,0.12);
        outline: none;
      }

      .btn-login {
        background-color: #3d8ef8;
        color: #fff;
        width: 100%;
        padding: 11px;
        border: none;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
      }

      .btn-login:hover {
        background-color: #2d7de8;
      }

      .login-footer {
        margin-top: 16px;
        font-size: 12px;
        color: #aaa;
      }

      .login-footer a {
        color: #3d8ef8;
        text-decoration: none;
      }
  %body
    .login-card
      / Avatar icon
      .avatar-circle
        %i.bi.bi-person-fill
      .login-title Sign In
      - if flash[:alert]
        .alert.alert-danger.py-2.text-start{:style => "font-size:13px;"}
          = flash[:alert]
      = form_for(resource, as: resource_name, url: session_path(resource_name), html: { "data-turbo" => "false" }) do |f|
        .mb-3
          = f.email_field :email,  |
            autofocus: true,       |
            autocomplete: "email", |
            class: "form-control", |
            placeholder: "Email"   |
        .mb-4
          = f.password_field :password,       |
            autocomplete: "current-password", |
            class: "form-control",            |
            placeholder: "Password"           |
        = f.submit "Login", class: "btn-login"
      .login-footer
        - if devise_mapping.recoverable? && controller_name != 'passwords'
          = link_to "Forgot your password?", new_password_path(resource_name)
