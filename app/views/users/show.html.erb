<div class="card border-0 shadow-sm" style="max-width: 680px;">
  <div class="card-header bg-white d-flex justify-content-between align-items-center">
    <span class="fw-bold"><%= @user.fullname %></span>
    <div class="d-flex gap-2">
      <%= link_to "Edit", edit_user_path(@user), class: "btn btn-sm btn-outline-primary" %>
      <%= link_to "Back", users_path, class: "btn btn-sm btn-outline-secondary" %>
    </div>
  </div>
  <div class="card-body">

    <div class="row mb-3">
      <div class="col-md-4 text-muted">Email</div>
      <div class="col-md-8"><%= @user.email %></div>
    </div>

    <div class="row mb-3">
      <div class="col-md-4 text-muted">Role</div>
      <div class="col-md-8">
        <% role_color = { "admin" => "danger", "agent" => "success", "manager" => "primary", "customer" => "secondary" } %>
        <span class="badge bg-<%= role_color[@user.role] %>"><%= @user.role.humanize %></span>
      </div>
    </div>

    <div class="row mb-3">
      <div class="col-md-4 text-muted">Team</div>
      <div class="col-md-8"><%= @user.team&.name || "-" %></div>
    </div>

    <div class="row mb-3">
      <div class="col-md-4 text-muted">Contact</div>
      <div class="col-md-8"><%= @user.contact_no || "-" %></div>
    </div>

    <div class="row mb-3">
      <div class="col-md-4 text-muted">Address</div>
      <div class="col-md-8"><%= @user.address || "-" %></div>
    </div>

    <div class="row mb-3">
      <div class="col-md-4 text-muted">Status</div>
      <div class="col-md-8">
        <% if @user.is_active? %>
          <span class="badge bg-success">Active</span>
        <% else %>
          <span class="badge bg-secondary">Inactive</span>
        <% end %>
      </div>
    </div>

    <div class="row mb-3">
      <div class="col-md-4 text-muted">Joined</div>
      <div class="col-md-8"><%= @user.created_at.strftime("%B %d, %Y") %></div>
    </div>

    <% if @user.agent? || @user.manager? %>
      <hr>
      <div class="row mb-3">
        <div class="col-md-4 text-muted">Assigned Tickets</div>
        <div class="col-md-8"><%= @user.assigned_tickets.count %></div>
      </div>
      <div class="row mb-3">
        <div class="col-md-4 text-muted">Closed Tickets</div>
        <div class="col-md-8"><%= @user.assigned_tickets.closed.count %></div>
      </div>
    <% end %>

    <% if @user.customer? %>
      <hr>
      <div class="row mb-3">
        <div class="col-md-4 text-muted">Tickets Submitted</div>
        <div class="col-md-8"><%= @user.customer_tickets.count %></div>
      </div>
      <div class="row mb-3">
        <div class="col-md-4 text-muted">Open Tickets</div>
        <div class="col-md-8"><%= @user.customer_tickets.open.count %></div>
      </div>
    <% end %>

  </div>
</div>
