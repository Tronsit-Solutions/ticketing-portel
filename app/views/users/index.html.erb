<div class="d-flex justify-content-between align-items-center mb-4">
  <h4 class="mb-0" style="font-family: Poppins;">Users</h4>
  <%= link_to "+ Add User", new_user_path, class: "btn btn-primary btn-sm" %>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body py-2">
    <%= form_with url: users_path, method: :get, local: true, class: "row g-2 align-items-end" do |f| %>

      <div class="col-md-3">
        <%= label_tag :role, "Role", class: "form-label mb-1 fw-bold" %>
        <%= select_tag :role,
            options_for_select(
              [["All Roles", ""], ["Admin", "admin"], ["Agent", "agent"], ["Manager", "manager"], ["Customer", "customer"]],
              params[:role]
            ),
            class: "form-select form-select-sm" %>
      </div>

      <div class="col-md-3">
        <%= label_tag :active, "Status", class: "form-label mb-1 fw-bold" %>
        <%= select_tag :active,
            options_for_select(
              [["All", ""], ["Active", "true"], ["Inactive", "false"]],
              params[:active]
            ),
            class: "form-select form-select-sm" %>
      </div>

      <div class="col-md-2">
        <%= f.submit "Filter", class: "btn btn-outline-primary btn-sm" %>
      </div>

      <div class="col-md-2">
        <%= link_to "Clear", users_path, class: "btn btn-outline-secondary btn-sm" %>
      </div>

    <% end %>
  </div>
</div>

<!-- Users Table -->
<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <table class="table table-hover mb-0">
      <thead class="table-light">
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Role</th>
          <th>Team</th>
          <th>Status</th>
          <th>Joined</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td class="fw-bold"><%= user.fullname %></td>
            <td class="text-muted" style="font-size:13px;"><%= user.email %></td>
            <td>
              <% role_color = { "admin" => "danger", "agent" => "success", "manager" => "primary", "customer" => "secondary" } %>
              <span class="badge bg-<%= role_color[user.role] %>">
                <%= user.role.humanize %>
              </span>
            </td>
            <td><%= user.team&.name || "-" %></td>
            <td>
              <% if user.is_active? %>
                <span class="badge bg-success">Active</span>
              <% else %>
                <span class="badge bg-secondary">Inactive</span>
              <% end %>
            </td>
            <td style="font-size:13px;"><%= user.created_at.strftime("%b %d, %Y") %></td>
            <td class="d-flex gap-1">
              <%= link_to "View", user_path(user), class: "btn btn-sm btn-outline-secondary" %>
              <%= link_to "Edit", edit_user_path(user), class: "btn btn-sm btn-outline-primary" %>
              <% if user.is_active? && user != current_user %>
                <%= button_to "Deactivate",
                    deactivate_user_path(user),
                    method: :patch,
                    class: "btn btn-sm btn-outline-danger",
                    data: { turbo_confirm: "Deactivate this user?" } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
