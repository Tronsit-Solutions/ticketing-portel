- if current_user.customer?
  :css
    .new-ticket-layout {
      display: grid;
      grid-template-columns: 300px 1fr;
      gap: 28px;
      align-items: start;
    }
    .panel-title {
      font-size: 15px;
      font-weight: 600;
      color: #1a1a1a;
      margin-bottom: 14px;
    }
    .category-chip {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 18px;
      background: #f3f4f6;
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      text-decoration: none;
      color: #1a1a1a;
      font-size: 14px;
      font-weight: 500;
      transition: background 0.15s, border-color 0.15s;
    }
    .category-chip:hover { background: #e8f4fb; border-color: #0077b6; color: #0077b6; }
    .category-chip .chip-count {
      background: #e5e7eb;
      color: #374151;
      border-radius: 20px;
      padding: 2px 10px;
      font-size: 13px;
      font-weight: 600;
    }
    .form-header {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 18px;
      font-weight: 700;
      color: #1a1a1a;
      margin-bottom: 24px;
    }
    .form-header-back {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      background: #1a1a1a;
      color: #fff;
      border-radius: 6px;
      text-decoration: none;
      font-size: 15px;
      flex-shrink: 0;
      transition: background 0.15s;
    }
    .form-header-back:hover { background: #0077b6; color: #fff; }
    .cust-form-label {
      font-size: 14px;
      font-weight: 600;
      color: #1a1a1a;
      margin-bottom: 6px;
      display: block;
    }
    .cust-form-control, .cust-form-select {
      width: 100%;
      border: 1px solid #dde2ea;
      border-radius: 8px;
      font-size: 14px;
      padding: 10px 14px;
      color: #1a1a1a;
      background: #fafbfc;
      transition: border-color 0.15s, box-shadow 0.15s;
      outline: none;
    }
    .cust-form-control:focus, .cust-form-select:focus {
      border-color: #0077b6;
      box-shadow: 0 0 0 3px rgba(0,119,182,0.10);
      background: #fff;
    }
    textarea.cust-form-control { resize: vertical; min-height: 120px; }
    .cust-field { margin-bottom: 20px; }
    .cust-submit-row {
      display: flex;
      justify-content: flex-end;
      margin-top: 8px;
    }
    .btn-cust-submit {
      background: #0077b6;
      color: #fff;
      border: none;
      border-radius: 8px;
      padding: 10px 32px;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.15s;
    }
    .btn-cust-submit:hover { background: #005f8e; }
    .notice-banner {
      background: #e8f4fb;
      border: 1px solid #b3d7ee;
      border-radius: 8px;
      padding: 10px 16px;
      font-size: 13px;
      color: #0077b6;
      margin-bottom: 20px;
    }

  .new-ticket-layout
    / Left — Navigation
    .left-panel
      .panel-title Navigation
      = link_to tickets_path, class: "category-chip" do
        %span My Tickets

    / Right — Form
    .right-panel
      .form-header
        = link_to @ticket, class: "form-header-back", "aria-label" => "Back" do
          %i.bi.bi-arrow-left
        New Team Member or Departure


      = form_with model: @termination_detail, url: ticket_termination_detail_path(@ticket), method: :post, local: true do |f|
        = render "termination_details/form", f: f, termination_detail: @termination_detail, css_class: "cust"

        .cust-submit-row
          = f.submit "Submit", class: "btn-cust-submit"

- else
  :css
    .form-back-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: #6b7280;
      font-size: 14px;
      text-decoration: none;
      margin-bottom: 24px;
      transition: color 0.15s;
    }
    .form-back-link:hover { color: #0077b6; }
    .form-card {
      background: #ffffff;
      border: 1px solid #e8edf2;
      border-radius: 14px;
      padding: 36px 40px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    }
    .form-label {
      font-size: 13px;
      font-weight: 600;
      color: #374151;
      margin-bottom: 6px;
      display: block;
    }
    .form-control, .form-select {
      border: 1px solid #dde2ea;
      border-radius: 8px;
      font-size: 14px;
      padding: 10px 14px;
      color: #1a1a1a;
      background: #fafbfc;
      transition: border-color 0.15s, box-shadow 0.15s;
    }
    .form-control:focus, .form-select:focus {
      border-color: #0077b6;
      box-shadow: 0 0 0 3px rgba(0,119,182,0.10);
      background: #fff;
    }
    textarea.form-control { resize: vertical; min-height: 120px; }
    .mb-3 { margin-bottom: 20px; }
    .btn-submit {
      background: #0077b6;
      color: #fff;
      border: none;
      border-radius: 8px;
      padding: 11px 32px;
      font-size: 15px;
      font-weight: 600;
      transition: background 0.15s, box-shadow 0.15s;
    }
    .btn-submit:hover { background: #005f8e; color: #fff; box-shadow: 0 3px 10px rgba(0,119,182,0.25); }
    .btn-cancel {
      background: #f3f4f6;
      color: #374151;
      border: 1px solid #e0e3e8;
      border-radius: 8px;
      padding: 11px 24px;
      font-size: 15px;
      font-weight: 500;
      transition: background 0.15s;
    }
    .btn-cancel:hover { background: #e8edf2; color: #1a1a1a; }
    .notice-banner {
      background: #e8f4fb;
      border: 1px solid #b3d7ee;
      border-radius: 8px;
      padding: 10px 16px;
      font-size: 13px;
      color: #0077b6;
      margin-bottom: 20px;
    }

  = link_to @ticket, class: "form-back-link" do
    %i.bi.bi-arrow-left
    Back to ticket

  .ticket-type-badge.mb-3
    %i.bi.bi-person-dash
    New Team Member or Departure — Termination

  %h4.fw-bold.mb-1{style: "font-size: 20px;"} Termination Details
  %p.text-muted.mb-4{style: "font-size: 14px;"} Please complete the termination details for this ticket.

  - if flash[:notice].present?
    .notice-banner= flash[:notice]

  .form-card
    = form_with model: @termination_detail, url: ticket_termination_detail_path(@ticket), method: :post, local: true do |f|
      = render "termination_details/form", f: f, termination_detail: @termination_detail, css_class: "std"

      .d-flex.align-items-center.gap-3.mt-4.pt-2
        = f.submit "Submit", class: "btn btn-submit"
        = link_to "Skip", @ticket, class: "btn btn-cancel"
