- label_class  = css_class == "cust" ? "cust-form-label"  : "form-label"
- input_class  = css_class == "cust" ? "cust-form-control" : "form-control"
- select_class = css_class == "cust" ? "cust-form-select"  : "form-select"
- field_wrap   = css_class == "cust" ? "cust-field"        : "mb-3"

:css
  .team-select-box {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    width: 100%;
    min-height: 46px;
    padding: 8px 10px;
    border: 1px solid #dde2ea;
    border-radius: 8px;
    background: #fafbfc;
    cursor: pointer;
  }
  .team-select-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    background: #eef1f5;
    border-radius: 16px;
    font-size: 13px;
    color: #1a1a1a;
  }
  .team-select-pill-remove {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
    border: none;
    background: transparent;
    color: #6b7280;
    font-size: 13px;
    line-height: 1;
    cursor: pointer;
    padding: 0;
  }
  .team-select-pill-remove:hover { color: #1a1a1a; }
  .team-dropdown-menu {
    max-height: 260px;
    overflow-y: auto;
    padding: 6px 0;
  }
  .team-dropdown-option {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 16px;
    margin: 0;
    font-size: 14px;
    font-weight: 400;
    cursor: pointer;
  }
  .team-dropdown-option:hover { background: #f3f4f6; }
  .team-dropdown-checkbox {
    flex: 0 0 16px;
    width: 16px;
    height: 16px;
    margin: 0;
  }
  .team-select-summary {
    padding: 10px 14px;
    background: #ffffff;
    border: 1px solid #dde2ea;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    color: #374151;
  }
  .team-select-summary:empty { display: none; }

%div{class: field_wrap}
  = f.label :start_date, "Start Date", class: label_class
  = f.date_field :start_date, class: input_class

%div{class: field_wrap}
  = f.label :date_of_birth, "Date of Birth", class: label_class
  = f.date_field :date_of_birth, class: input_class

%div{class: field_wrap}
  = f.label :title_position, "Title/Position :", class: label_class
  = f.select :title_position, options_for_select(DropdownOption.for(DropdownOption::HIRING_TITLE_POSITION).pluck(:label, :value), hiring_detail.title_position), { prompt: "Select Option" }, class: select_class

%div{class: field_wrap, data: {controller: "provider-fields", action: "provider-fields#toggle"}}
  = f.label :is_provider, "Is this user a provider ?", class: label_class
  = f.select :is_provider, options_for_select([["No", false], ["Yes", true]], hiring_detail.is_provider), {}, class: select_class, data: {"provider-fields-target": "select", action: "change->provider-fields#toggle"}

  %div{data: {"provider-fields-target": "fields"}}
    %div{class: field_wrap}
      = f.label :billing_provider_name, "Name of the Billing provider ?", class: label_class
      = f.text_field :billing_provider_name, class: input_class, placeholder: "Your Answer"

    %div{class: field_wrap}
      = f.label :provider_npi, "Provider NPI ?", class: label_class
      = f.text_field :provider_npi, class: input_class, placeholder: "Your Answer"

    %div{class: field_wrap, data: {controller: "provider-fields", action: "provider-fields#toggle"}}
      = f.label :q5_q6_modifier_required, "IS Q5/Q6 modifier required?", class: label_class
      = f.select :q5_q6_modifier_required, options_for_select([["No", false], ["Yes", true]], hiring_detail.q5_q6_modifier_required), {}, class: select_class, data: {"provider-fields-target": "select", action: "change->provider-fields#toggle"}

      %div{class: field_wrap, data: {"provider-fields-target": "fields"}}
        = f.label :q5_q6_modifier, "Select Approriate Modifier", class: label_class
        = f.select :q5_q6_modifier, options_for_select([["Choose option", nil]] + HiringDetail::Q5_Q6_MODIFIERS, hiring_detail.q5_q6_modifier), {}, class: select_class

%div{class: field_wrap}
  = f.label :department, "Please select their Department :", class: label_class
  = f.select :department, options_for_select(DropdownOption.for(DropdownOption::HIRING_DEPARTMENT).pluck(:label, :value), hiring_detail.department), { prompt: "Select Option" }, class: select_class

%div{class: field_wrap}
  %label{class: label_class} What Access/Systems Are Needed ?
  - DropdownOption.for(DropdownOption::HIRING_ACCESS_SYSTEMS).each do |system|
    .form-check
      = check_box_tag "hiring_detail[access_systems][]", system.value, Array(hiring_detail.access_systems).include?(system.value), id: "access_#{system.value.parameterize}", class: "form-check-input"
      = label_tag "access_#{system.value.parameterize}", system.label, class: "form-check-label"

%div{class: field_wrap}
  %label{class: label_class} Gender:
  .form-check
    = radio_button_tag "hiring_detail[gender]", "Male", hiring_detail.gender == "Male", id: "gender_male", class: "form-check-input"
    = label_tag "gender_male", "Male", class: "form-check-label"
  .form-check
    = radio_button_tag "hiring_detail[gender]", "Female", hiring_detail.gender == "Female", id: "gender_female", class: "form-check-input"
    = label_tag "gender_female", "Female", class: "form-check-label"

%div{class: field_wrap}
  = f.label :cell_phone, "Cell Phone Number", class: label_class
  = f.text_field :cell_phone, class: input_class, placeholder: "Your Answer"

%div{class: field_wrap}
  = f.label :badge_number, "What is the badge Number?", class: label_class
  = f.text_field :badge_number, class: input_class, placeholder: "Your Answer"

%div{class: field_wrap}
  %label{class: label_class} What Distribution Groups should the new team mate be added to if any?
  - DropdownOption.for(DropdownOption::HIRING_DISTRIBUTION_GROUPS).each do |group|
    .form-check
      = check_box_tag "hiring_detail[distribution_groups][]", group.value, Array(hiring_detail.distribution_groups).include?(group.value), id: "dist_#{group.value.parameterize}", class: "form-check-input"
      = label_tag "dist_#{group.value.parameterize}", group.label, class: "form-check-label"

%div{class: field_wrap, data: {controller: "multi-select-summary"}}
  = f.label :microsoft_teams_department, "What Microsoft Teams should the member be a part of ?", class: label_class
  .dropdown
    .team-select-box{"data-bs-toggle": "dropdown", "aria-expanded": "false", data: {"multi-select-summary-target": "pillBox"}}
    %ul.dropdown-menu.w-100.team-dropdown-menu
      - Team.ordered.pluck(:name).each do |team|
        %li
          %label.team-dropdown-option{for: "team_#{team.parameterize}"}
            %input.team-dropdown-checkbox{type: "checkbox", name: "hiring_detail[microsoft_teams_department][]", value: team, checked: Array(hiring_detail.microsoft_teams_department).include?(team), id: "team_#{team.parameterize}", data: {"multi-select-summary-target": "checkbox", action: "change->multi-select-summary#render"}}
            %span= team
  %div.team-select-summary.mt-2{data: {"multi-select-summary-target": "summary"}}

%div{class: field_wrap}
  = f.label :credentials_send_to, "Who should we send their credentials to if anyone ?", class: label_class
  = f.text_field :credentials_send_to, class: input_class, placeholder: "Your Answer"

%div{class: field_wrap}
  %label{class: label_class} PC Requirements:
  - HiringDetail::PC_REQUIREMENTS.each do |req|
    .form-check
      = radio_button_tag "hiring_detail[pc_requirement]", req, hiring_detail.pc_requirement == req, id: "pc_#{req.parameterize}", class: "form-check-input"
      = label_tag "pc_#{req.parameterize}", req, class: "form-check-label"

%div{class: field_wrap}
  = f.label :existing_pc_user, "If existing PC, who was using before ?", class: label_class
  = f.text_field :existing_pc_user, class: input_class, placeholder: "Your Answer"

%div{class: field_wrap}
  = f.label :additional_info, "Any other information that would be useful to know:(Application/FOB) ? Number/Special Setup/Requirement)", class: label_class
  = f.text_area :additional_info, class: input_class, placeholder: "Your Answer", rows: 5

