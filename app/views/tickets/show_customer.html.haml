= turbo_stream_from @ticket, :messages

:css
  .show-layout {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 28px;
    align-items: start;
  }
  .panel-title {
    font-size: 15px;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 14px;
  }
  .category-chip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    background: #f3f4f6;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    text-decoration: none;
    color: #1a1a1a;
    font-size: 14px;
    font-weight: 500;
    transition: background 0.15s, border-color 0.15s;
  }
  .category-chip:hover { background: #e8f4fb; border-color: #0077b6; color: #0077b6; }
  .category-chip .chip-count {
    background: #e5e7eb;
    color: #374151;
    border-radius: 20px;
    padding: 2px 10px;
    font-size: 13px;
    font-weight: 600;
  }
  .ticket-detail-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    overflow: hidden;
  }
  .ticket-detail-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 24px;
    border-bottom: 1px solid #f0f0f0;
  }
  .ticket-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    color: #1a1a1a;
  }
  .ticket-breadcrumb i { font-size: 16px; color: #374151; }
  .ticket-breadcrumb .sep { color: #9ca3af; font-weight: 400; }
  .ticket-breadcrumb .status-badge {
    font-size: 13px;
    font-weight: 600;
    color: #1a1a1a;
  }
  .ticket-detail-body {
    padding: 0;
  }
  .ticket-message-block {
    padding: 20px 28px;
    border-bottom: 1px solid #e5e7eb;
  }
  .ticket-message-block:last-child { border-bottom: none; }
  .ticket-msg-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }
  .ticket-msg-date {
    font-size: 13px;
    color: #6b7280;
    font-weight: 700;
  }
  .ticket-field {
    font-size: 14px;
    color: #374151;
    margin-bottom: 12px;
  }
  .ticket-field .field-label {
    font-weight: 600;
    color: #1a1a1a;
    margin-right: 4px;
  }
  .ticket-field .field-value { color: #0077b6; }
  .ticket-msg-text {
    font-size: 14px;
    color: #0077b6;
  }
  .structured-field {
    font-size: 14px;
    margin-bottom: 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .structured-label {
    font-weight: 600;
    color: #1a1a1a;
    min-width: 120px;
  }
  .structured-label::after { content: ":"; }
  .structured-value { color: #0077b6; }
  .folder-btn {
    background: none;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 6px 10px;
    color: #6b7280;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
    text-decoration: none;
  }
  .folder-btn:hover { border-color: #0077b6; color: #0077b6; }
  .ticket-reply-form {
    padding: 20px 28px;
    border-top: 1px solid #e5e7eb;
    background: #f9fafb;
  }
  .msg-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.45);
    z-index: 2000;
    align-items: center;
    justify-content: center;
  }
  .msg-modal-overlay.open { display: flex; }
  .msg-modal {
    background: #fff;
    border-radius: 14px;
    width: 520px;
    max-width: 95vw;
    max-height: 80vh;
    overflow-y: auto;
    box-shadow: 0 8px 32px rgba(0,0,0,0.18);
  }
  .msg-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 24px 14px;
    border-bottom: 1px solid #f0f0f0;
  }
  .msg-modal-title {
    font-size: 14px;
    font-weight: 600;
    color: #6b7280;
  }
  .msg-modal-close {
    background: none;
    border: none;
    font-size: 20px;
    color: #9ca3af;
    cursor: pointer;
    line-height: 1;
    padding: 0;
  }
  .msg-modal-close:hover { color: #1a1a1a; }
  .msg-modal-body {
    padding: 20px 24px 24px;
  }
  .msg-modal-body .ticket-field { margin-bottom: 14px; }
  .msg-modal-body .ticket-field .field-label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: #9ca3af;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 2px;
  }
  .msg-modal-body .ticket-field .field-value {
    font-size: 14px;
    color: #0077b6;
  }

:javascript
  function openMsgModal(data) {
    var body = document.getElementById('msgModalBody');
    body.innerHTML = '';
    data.forEach(function(row) {
      var div = document.createElement('div');
      div.className = 'ticket-field';
      div.innerHTML = '<span class="field-label">' + row.label + '</span><span class="field-value">' + row.value + '</span>';
      body.appendChild(div);
    });
    document.getElementById('msgModalOverlay').classList.add('open');
  }
  function closeMsgModal() {
    document.getElementById('msgModalOverlay').classList.remove('open');
  }
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeMsgModal();
  });

#msgModalOverlay.msg-modal-overlay{"onclick" => "if(event.target===this)closeMsgModal()"}
  .msg-modal
    .msg-modal-header
      %span.msg-modal-title Details
      %button.msg-modal-close{"onclick" => "closeMsgModal()", "aria-label" => "Close"} &times;
    .msg-modal-body#msgModalBody

.show-layout
  / Left — Categories
  .left-panel
    .panel-title Categories
    = link_to tickets_path, class: "category-chip" do
      %span My Tickets
      %span.chip-count= @my_tickets_count

  / Right — Ticket Detail
  .right-panel
    .ticket-detail-card
      .ticket-detail-header
        .ticket-breadcrumb
          %i.bi.bi-envelope-fill
          %span Tickets
          %span.sep /
          %span= @ticket.type_label
          %span.sep |
          %span \##{@ticket.id}
          %span.sep
          %span.status-badge [ #{@ticket.status.humanize} ]

      .ticket-detail-body
        / Original ticket submission
        - ticket_modal_data = [{ label: "Subject", value: @ticket.title }]
        - ticket_modal_data << { label: "Issue", value: @ticket.metadata["details"] } if @ticket.metadata["details"].present?
        - (@ticket.metadata.except("details") || {}).each { |k,v| ticket_modal_data << { label: k.humanize, value: v } if v.present? }
        - if @ticket.ticket_type.in?(%w[hiring departure])
          - if @ticket.departure? && (td = @ticket.termination_detail).present?
            - ticket_modal_data << { label: "Termination Reason", value: td.termination_reason }
            - ticket_modal_data << { label: "Termination Date", value: td.termination_date&.strftime("%b %d, %Y") }
            - ticket_modal_data << { label: "Time to Process", value: td.termination_time }
            - ticket_modal_data << { label: "Email Address", value: td.email_address }
            - ticket_modal_data << { label: "Key Card", value: td.key_card }
            - ticket_modal_data << { label: "Email Forward Needed", value: td.email_forward_needed? ? "Yes" : "No" }
            - ticket_modal_data << { label: "Forward Email To", value: td.email_forwarded_to }
            - ticket_modal_data << { label: "Historical Email Access", value: td.historical_email_access? ? "Yes" : "No" }
            - ticket_modal_data << { label: "Additional Instructions", value: td.additional_instructions }
          - elsif (hd = @ticket.hiring_detail).present?
            - ticket_modal_data << { label: "Start Date", value: hd.start_date&.strftime("%b %d, %Y") }
            - ticket_modal_data << { label: "Date of Birth", value: hd.date_of_birth&.strftime("%b %d, %Y") }
            - ticket_modal_data << { label: "Title/Position", value: hd.title_position }
            - ticket_modal_data << { label: "Is Provider", value: hd.is_provider? ? "Yes" : "No" }
            - if hd.is_provider?
              - ticket_modal_data << { label: "Name of the Billing Provider", value: hd.billing_provider_name }
              - ticket_modal_data << { label: "Provider NPI", value: hd.provider_npi }
              - ticket_modal_data << { label: "Q5/Q6 Modifier Required", value: hd.q5_q6_modifier_required? ? "Yes" : "No" }
              - ticket_modal_data << { label: "Selected Modifier", value: hd.q5_q6_modifier } if hd.q5_q6_modifier_required?
            - ticket_modal_data << { label: "Department", value: hd.department }
            - ticket_modal_data << { label: "Gender", value: hd.gender }
            - ticket_modal_data << { label: "Cell Phone", value: hd.cell_phone }
            - ticket_modal_data << { label: "Badge Number", value: hd.badge_number }
            - ticket_modal_data << { label: "Access/Systems", value: Array(hd.access_systems).reject(&:blank?).join(", ") }
            - ticket_modal_data << { label: "Distribution Groups", value: Array(hd.distribution_groups).reject(&:blank?).join(", ") }
            - ticket_modal_data << { label: "Microsoft Teams", value: Array(hd.microsoft_teams_department).reject(&:blank?).join(", ") }
            - ticket_modal_data << { label: "Credentials Send To", value: hd.credentials_send_to }
            - ticket_modal_data << { label: "PC Requirement", value: hd.pc_requirement }
            - ticket_modal_data << { label: "Existing PC User", value: hd.existing_pc_user }
            - ticket_modal_data << { label: "Additional Info", value: hd.additional_info }
        - ticket_modal_data.reject! { |r| r[:value].blank? }
        - ticket_modal_json = ticket_modal_data.map { |r| "{label:#{r[:label].to_json},value:#{r[:value].to_json}}" }.join(",")
        .ticket-message-block
          .ticket-msg-header
            .ticket-msg-date= @ticket.created_at.strftime("%B %-d, %Y at %-I:%M %p")
            %button.folder-btn{"onclick" => "openMsgModal([#{ticket_modal_json}])", "type" => "button", "aria-label" => "View details"}
              %i.bi.bi-folder2-open

          .ticket-field
            %span.field-label Title:
            %span.field-value= @ticket.title

          - if @ticket.metadata["details"].present?
            .ticket-field
              %span.field-label Description:
              %span.field-value= @ticket.metadata["details"]

          - (@ticket.metadata.except("details") || {}).each do |key, value|
            - next if value.blank?
            .ticket-field
              %span.field-label= "#{key.humanize}:"
              %span.field-value= value

          / Hiring/Termination details inline display for customer
          - if @ticket.ticket_type.in?(%w[hiring departure])
            - if @ticket.departure?
              - td = @ticket.termination_detail
              - if td.present?
                - [["Termination Reason", td.termination_reason], ["Termination Date", td.termination_date&.strftime("%b %d, %Y")], ["Time to Process", td.termination_time], ["Email Address", td.email_address], ["Key Card", td.key_card], ["Email Forward Needed", td.email_forward_needed? ? "Yes" : "No"], ["Forward Email To", td.email_forwarded_to], ["Historical Email Access", td.historical_email_access? ? "Yes" : "No"], ["Additional Instructions", td.additional_instructions]].each do |label, value|
                  - next if value.blank?
                  .ticket-field
                    %span.field-label= "#{label}:"
                    %span.field-value= value
              - else
                .ticket-field
                  %span.field-label Termination Details:
                  %span.field-value.text-muted Not yet submitted.
            - else
              - hd = @ticket.hiring_detail
              - if hd.present?
                - provider_fields = hd.is_provider? ? [["Name of the Billing Provider", hd.billing_provider_name], ["Provider NPI", hd.provider_npi], ["Q5/Q6 Modifier Required", hd.q5_q6_modifier_required? ? "Yes" : "No"]] : []
                - provider_fields << ["Selected Modifier", hd.q5_q6_modifier] if hd.is_provider? && hd.q5_q6_modifier_required?
                - ([["Start Date", hd.start_date&.strftime("%b %d, %Y")], ["Date of Birth", hd.date_of_birth&.strftime("%b %d, %Y")], ["Title/Position", hd.title_position], ["Is Provider", hd.is_provider? ? "Yes" : "No"]] + provider_fields + [["Department", hd.department], ["Gender", hd.gender], ["Cell Phone", hd.cell_phone], ["Badge Number", hd.badge_number], ["Access/Systems", Array(hd.access_systems).reject(&:blank?).join(", ")], ["Distribution Groups", Array(hd.distribution_groups).reject(&:blank?).join(", ")], ["Microsoft Teams", Array(hd.microsoft_teams_department).reject(&:blank?).join(", ")], ["Credentials Send To", hd.credentials_send_to], ["PC Requirement", hd.pc_requirement], ["Existing PC User", hd.existing_pc_user], ["Additional Info", hd.additional_info]]).each do |label, value|
                  - next if value.blank?
                  .ticket-field
                    %span.field-label= "#{label}:"
                    %span.field-value= value
              - else
                .ticket-field
                  %span.field-label Hiring Details:
                  %span.field-value.text-muted Not yet submitted.

        / Message thread
        #ticket_messages_customer
          - visible_messages = @ticket_messages.reject(&:internal_note?)
          = render partial: "ticket_messages/message_customer", collection: visible_messages, as: :message

- if @ticket.status.in?(%w[open in_progress])
  / ── Send Message Modal ──────────────────────────────────────────
  #sendMessageModal.modal.fade{"aria-labelledby" => "sendMessageModalLabel", "aria-hidden" => "true", tabindex: "-1"}
    .modal-dialog.modal-dialog-centered
      .modal-content
        .modal-header.border-0.pb-0
          %button.btn-close{"data-bs-dismiss" => "modal", type: "button", "aria-label" => "Close"}
        = form_with url: ticket_ticket_messages_path(@ticket), method: :post, local: true do |f|
          .modal-body
            %h5.fw-semibold.mb-3 Send Message
            = text_area_tag "details", nil, rows: 8, class: "form-control", required: true
          .modal-footer.border-0.pt-0.justify-content-center
            = f.submit "Submit", class: "btn btn-dark px-4"

  / ── Cancel Ticket Modal ──────────────────────────────────────────
  #cancelTicketModal.modal.fade{"aria-labelledby" => "cancelTicketModalLabel", "aria-hidden" => "true", tabindex: "-1"}
    .modal-dialog.modal-dialog-centered
      .modal-content
        .modal-header.border-0.pb-0
          %button.btn-close{"data-bs-dismiss" => "modal", type: "button", "aria-label" => "Close"}
        = form_with url: cancel_ticket_path(@ticket), method: :patch, local: true do |f|
          .modal-body
            .text-center.mb-3
              %i.bi.bi-exclamation-triangle.text-danger{style: "font-size: 2.5rem;"}
              %p.mt-3.mb-1.fw-semibold Are you sure you want to cancel this ticket?
              %p.text-muted{style: "font-size: 13px;"}= "\"#{@ticket.title}\""
          .modal-footer.border-0.pt-0.justify-content-center.gap-2
            %button.btn.btn-outline-secondary{"data-bs-dismiss" => "modal", type: "button"} Keep Ticket
            = f.submit "Cancel Ticket", class: "btn btn-danger px-4"

