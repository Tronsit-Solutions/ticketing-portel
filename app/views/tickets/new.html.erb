<div class="d-flex align-items-center gap-2 mb-4">
  <%= link_to catalogue_tickets_path, class: "text-muted text-decoration-none" do %>
    <i class="bi bi-arrow-left"></i> Back to catalogue
  <% end %>
</div>

<div class="card border-0 shadow-sm" style="max-width: 680px;">
  <div class="card-header bg-white">
    <div class="fw-bold">
      <% if current_user.agent? || current_user.admin? %>
        Create Ticket On Behalf of a Customer
      <% else %>
        Submit a New Ticket
      <% end %>
    </div>
    <% if @ticket_type %>
      <div class="text-muted mt-1" style="font-size: 13px;">
        <i class="bi <%= @ticket_type[:icon] %> me-1"></i>
        <%= @ticket_type[:label] %>
      </div>
    <% end %>
  </div>

  <div class="card-body">

    <% if current_user.agent? || current_user.admin? %>
      <div class="alert alert-info py-2 mb-4" style="font-size:13px;">
        This ticket will be auto-assigned to you and marked <strong>On Behalf</strong>.
      </div>
    <% end %>

    <%= form_with model: @ticket, local: true do |f| %>

      <%= f.hidden_field :ticket_type, value: @ticket.ticket_type %>

      <% if current_user.agent? || current_user.admin? %>
        <div class="mb-3">
          <%= label_tag :customer_id, "Customer", class: "form-label fw-bold" %>
          <%= select_tag "ticket[customer_id]",
              options_from_collection_for_select(@customers, :id, :fullname),
              class: "form-select",
              prompt: "Select a customer" %>
          <div class="form-text text-muted">Who is this ticket for?</div>
        </div>
      <% end %>

      <div class="mb-3">
        <%= f.label :title, "Title", class: "form-label fw-bold" %>
        <%= f.text_field :title,
            class: "form-control",
            placeholder: "Short summary of the issue" %>
      </div>

      <div class="mb-3">
        <%= label_tag "ticket[metadata][description]", "Description", class: "form-label fw-bold" %>
        <%= text_area_tag "ticket[metadata][description]",
            @ticket.description,
            rows: 4,
            class: "form-control",
            placeholder: "Describe the issue in detail..." %>
      </div>

      <div class="mb-4">
        <%= f.label :location_id, "Location", class: "form-label fw-bold" %>
        <%= f.collection_select :location_id,
            Location.active.ordered, :id, :name,
            { prompt: "Select your location" },
            class: "form-select" %>
      </div>

      <div class="d-flex gap-2">
        <%= f.submit current_user.agent? || current_user.admin? ? "Submit On Behalf" : "Submit Ticket",
            class: "btn btn-primary" %>
        <%= link_to "Cancel", tickets_path, class: "btn btn-outline-secondary" %>
      </div>

    <% end %>
  </div>
</div>
