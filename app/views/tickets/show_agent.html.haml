:css
  .structured-field {
    font-size: 14px;
    margin-bottom: 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .structured-label {
    font-weight: 600;
    color: #1a1a1a;
    min-width: 120px;
  }
  .structured-label::after { content: ":"; }
  .structured-value { color: #0077b6; }

/ ── Two-column layout ───────────────────────────────────────────
.row.g-3

  / ── Left: Ticket Info + Attachments + History ──────────────────
  .col-md-6

    / ── Merged: Header + Info + Details ────────────────────────────
    - status_color = { "open" => "primary", "in_progress" => "warning", "closed" => "success", "cancelled" => "danger" }
    .card.border-0.shadow-sm.mb-3
      .card-body
        / Status + actions row
        .d-flex.justify-content-between.align-items-start.mb-3
          %span{class: "badge bg-#{status_color[@ticket.status]}"}= @ticket.status.humanize
          .d-flex.gap-2
            - if @ticket.status != "closed" && (current_user.admin? || @ticket.assignee == current_user)
              %button.btn.btn-sm.btn-outline-danger{"data-bs-toggle" => "modal", "data-bs-target" => "#closeTicketModal", type: "button"} Close
            - if (current_user.admin? || current_user.manager?) && @ticket.status != "closed"
              %button.btn.btn-sm.btn-outline-primary{"data-bs-toggle" => "collapse", "data-bs-target" => "#assignForm"}
                = @ticket.assignee_id.nil? ? "Assign" : "Reassign"
            - if current_user.agent? && @ticket.assignee_id.nil?
              = button_to "Self Assign", self_assign_ticket_path(@ticket), method: :patch, class: "btn btn-sm btn-outline-success"

        / Title
        %h5.fw-bold.mb-0= @ticket.title
        - if @ticket.on_behalf?
          %span.badge.mt-1{style: "font-size:10px; background-color: #fdf2d0; color: #7d5a00;"}
            On Behalf — #{@ticket.created_by.fullname}
        %small.text-muted.d-block.mb-3 \##{@ticket.id} &middot; Submitted #{@ticket.created_at.strftime("%b %d, %Y")}

        %hr.my-2

        / Key fields
        .mb-2
          %small.text-muted Ticket Type
          %div= @ticket.ticket_type.humanize
        - if @ticket.customer&.contact_no.present?
          .mb-2
            %small.text-muted Phone
            %div= @ticket.customer.contact_no
        .mb-2
          %small.text-muted Location
          %div= @ticket.location&.name || "-"
        .mb-2
          %small.text-muted Customer
          %div= @ticket.customer&.fullname || "-"
        .mb-2
          %small.text-muted Assignee
          %div= @ticket.assignee&.fullname || "<span class='text-danger'>Unassigned</span>".html_safe
        - if @ticket.assigned_by.present?
          .mb-2
            %small.text-muted Assigned By
            %div= @ticket.assigned_by.fullname
        - if @ticket.assigned_at.present?
          .mb-2
            %small.text-muted Assigned At
            %div= @ticket.assigned_at.strftime("%b %d, %Y %I:%M %p")
        - if @ticket.resolved_at.present?
          .mb-2
            %small.text-muted Resolved At
            %div= @ticket.resolved_at.strftime("%b %d, %Y %I:%M %p")

        / Description / issue — only when present
        - details_val = @ticket.metadata["details"].presence || @ticket.metadata["Description "].presence
        - if details_val.present? || @ticket.metadata["issue"].present?
          %hr.my-2
        - if details_val.present?
          .mb-2
            %small.text-muted Description
            %div{style: "font-size:13px;"}= details_val
        - if @ticket.metadata["issue"].present?
          .mb-0
            %small.text-muted Issue Category
            %div{style: "font-size:13px;"}= @ticket.metadata["issue"]

    / Assign form collapse
    - if current_user.admin? || current_user.manager?
      #assignForm.collapse.mb-3
        .card.card-body.border-0.shadow-sm
          = form_with url: assign_ticket_path(@ticket), method: :patch, local: true do |f|
            .row.g-2.align-items-end
              .col-md-5
                = label_tag :assignee_id, "Assign to Agent", class: "form-label fw-bold"
                = select_tag :assignee_id, options_from_collection_for_select(User.agents.active, :id, :fullname, @ticket.assignee_id), class: "form-select", prompt: "Select agent"
              .col-md-5
                = label_tag :reason, "Reason (optional)", class: "form-label fw-bold"
                = text_field_tag :reason, nil, class: "form-control", placeholder: "Reason for assignment"
              .col-md-2
                = f.submit "Assign", class: "btn btn-primary w-100"

    / Hiring / Termination Detail card
    - if @ticket.ticket_type == "hiring_departure"
      - request_type = @ticket.metadata["request_type"]
      - if request_type == "Termination"
        - td = @ticket.termination_detail
        .card.border-0.shadow-sm.mb-3
          .card-header.bg-white.d-flex.justify-content-between.align-items-center
            %span.fw-bold Termination Details
            - unless td.present?
              = link_to "Fill Details", new_ticket_termination_detail_path(@ticket), class: "btn btn-sm btn-outline-primary"
          .card-body
            - if td.present?
              .row.g-3
                .col-md-6
                  %small.text-muted Termination Reason
                  %div= td.termination_reason || "-"
                .col-md-6
                  %small.text-muted Termination Date
                  %div= td.termination_date&.strftime("%b %d, %Y") || "-"
                .col-md-6
                  %small.text-muted Time to Process
                  %div= td.termination_time || "-"
                .col-md-6
                  %small.text-muted Email Address
                  %div= td.email_address || "-"
                .col-md-6
                  %small.text-muted Key Card
                  %div= td.key_card || "-"
                .col-md-6
                  %small.text-muted Email Forward Needed?
                  %div= td.email_forward_needed? ? "Yes" : "No"
                .col-md-6
                  %small.text-muted Forward Email To
                  %div= td.email_forwarded_to.presence || "-"
                .col-md-6
                  %small.text-muted Historical Email Access?
                  %div= td.historical_email_access? ? "Yes" : "No"
                .col-md-12
                  %small.text-muted Additional Instructions
                  %div= td.additional_instructions || "-"
            - else
              %p.text-muted.mb-0 Termination details not yet submitted.
      - else
        - hd = @ticket.hiring_detail
        .card.border-0.shadow-sm.mb-3
          .card-header.bg-white.d-flex.justify-content-between.align-items-center
            %span.fw-bold New Team Member Details
            - unless hd.present?
              = link_to "Fill Details", new_ticket_hiring_detail_path(@ticket), class: "btn btn-sm btn-outline-primary"
          .card-body
            - if hd.present?
              .row.g-3
                .col-md-6
                  %small.text-muted Start Date
                  %div= hd.start_date&.strftime("%b %d, %Y") || "-"
                .col-md-6
                  %small.text-muted Date of Birth
                  %div= hd.date_of_birth&.strftime("%b %d, %Y") || "-"
                .col-md-6
                  %small.text-muted Title / Position
                  %div= hd.title_position || "-"
                .col-md-6
                  %small.text-muted Is Provider?
                  %div= hd.is_provider? ? "Yes" : "No"
                .col-md-6
                  %small.text-muted Department
                  %div= hd.department || "-"
                .col-md-6
                  %small.text-muted Gender
                  %div= hd.gender || "-"
                .col-md-6
                  %small.text-muted Cell Phone
                  %div= hd.cell_phone || "-"
                .col-md-6
                  %small.text-muted Badge Number
                  %div= hd.badge_number || "-"
                .col-md-12
                  %small.text-muted Access / Systems Needed
                  %div= Array(hd.access_systems).reject(&:blank?).join(", ").presence || "-"
                .col-md-12
                  %small.text-muted Distribution Groups
                  %div= Array(hd.distribution_groups).reject(&:blank?).join(", ").presence || "-"
                .col-md-6
                  %small.text-muted Microsoft Teams Department
                  %div= hd.microsoft_teams_department || "-"
                .col-md-6
                  %small.text-muted Credentials Send To
                  %div= hd.credentials_send_to || "-"
                .col-md-6
                  %small.text-muted PC Requirement
                  %div= hd.pc_requirement || "-"
                .col-md-6
                  %small.text-muted Existing PC User
                  %div= hd.existing_pc_user || "-"
                .col-md-12
                  %small.text-muted Additional Info
                  %div= hd.additional_info || "-"
            - else
              %p.text-muted.mb-0 Hiring details not yet submitted.

    / Attachments
    - if @ticket.attachments.any?
      .card.border-0.shadow-sm.mb-3
        .card-header.bg-white.fw-bold Attachments
        .card-body.p-0
          - @ticket.attachments.each do |attachment|
            .d-flex.align-items-center.gap-2.px-3.py-2.border-bottom
              - if attachment.image?
                %i.bi.bi-file-image.text-primary{style: "font-size:16px;"}
              - else
                %i.bi.bi-file-earmark.text-secondary{style: "font-size:16px;"}
              = link_to attachment.filename.to_s, "#", class: "text-decoration-none text-dark", style: "font-size:13px;", "data-bs-toggle" => "modal", "data-bs-target" => "#attachmentPreviewModal", "data-attachment-url" => url_for(attachment), "data-attachment-name" => attachment.filename.to_s, "data-attachment-image" => attachment.blob.content_type.start_with?("image/").to_s

    / Assignment History
    .card.border-0.shadow-sm
      .card-header.bg-white.fw-bold Assignment History
      .card-body.p-0
        - if @ticket_assignments.any?
          - @ticket_assignments.each do |a|
            .px-3.py-2.border-bottom
              %small.text-muted= a.created_at.strftime("%b %d, %Y")
              %div{style: "font-size:13px;"}
                - if a.assigned_from.present?
                  %span.text-danger= a.assigned_from.fullname
                  →
                  %span.text-success= a.assigned_to.fullname
                - else
                  Assigned to
                  %span.text-success= a.assigned_to.fullname
              - if a.reason.present?
                %small.text-muted.fst-italic= a.reason
        - else
          .px-3.py-2.text-muted{style: "font-size:13px;"} No assignments yet.

  / ── Right: Conversation + Reply ────────────────────────────────
  .col-md-6

    / Resolution card — shown only when closed and resolution exists
    - if @ticket.status == "closed" && @ticket.resolution.present?
      .card.border-0.mb-3{style: "border-left: 4px solid #198754 !important; background: #f0fdf4;"}
        .card-body
          .d-flex.align-items-center.gap-2.mb-2
            %i.bi.bi-check-circle-fill.text-success
            %span.fw-bold.text-success Resolution
          %p.mb-1{style: "font-size:14px; color:#1a1a1a;"}= @ticket.resolution
          - if @ticket.resolved_by.present?
            %small.text-muted
              Resolved by
              %strong= @ticket.resolved_by.fullname
              = " · #{@ticket.resolved_at.strftime('%b %d, %Y')}" if @ticket.resolved_at.present?

    / Conversation
    .card.border-0.shadow-sm.mb-3
      .card-header.bg-white.fw-bold Conversation
      .card-body
        - if @ticket_messages.any?
          - @ticket_messages.each do |msg|
            %div{class: "mb-3 p-3 rounded #{msg.internal_note? ? 'bg-warning bg-opacity-10' : 'bg-light'}"}
              .d-flex.justify-content-between.mb-1
                %strong= msg.sender&.fullname || "System"
                %small.text-muted
                  = msg.created_at.strftime("%b %d, %Y %I:%M %p")
                  - if msg.internal_note?
                    %span.badge.bg-warning.text-dark.ms-1 Internal Note
              - if msg.structured_data.present?
                = render "shared/structured_message", data: msg.structured_data
              - else
                %p.mb-0= msg.details
        - else
          %p.text-muted.mb-0 No messages yet.

    / Reply form
    - if @ticket.status != "closed"
      - if current_user.admin? || @ticket.assignee == current_user
        .card.border-0.shadow-sm
          .card-header.bg-white.fw-bold Add Reply
          .card-body
            = form_with url: ticket_ticket_messages_path(@ticket), method: :post, local: true do |f|
              = f.text_area :details, rows: 4, class: "form-control mb-2", placeholder: "Write your reply here..."
              - if current_user.admin? || current_user.agent?
                .form-check.mb-2
                  = f.check_box :internal_note, { class: "form-check-input" }, "true", "false"
                  = f.label :internal_note, "Mark as internal note", class: "form-check-label text-muted"
              = f.submit "Send Reply", class: "btn btn-primary"

/ ── Attachment Preview Modal ─────────────────────────────────────
#attachmentPreviewModal.modal.fade{"aria-labelledby" => "attachmentPreviewLabel", "aria-hidden" => "true", tabindex: "-1"}
  .modal-dialog.modal-dialog-centered.modal-lg
    .modal-content
      .modal-header.border-0.pb-0
        %h6.modal-title#attachmentPreviewLabel.fw-bold{"id" => "attachmentPreviewLabel"} Attachment
        %button.btn-close{"data-bs-dismiss" => "modal", "aria-label" => "Close", type: "button"}
      .modal-body.text-center.p-3
        #attachmentImageContainer{style: "display:none;"}
          %img#attachmentImage.img-fluid.rounded{src: "", alt: "attachment", style: "max-height:70vh;"}
        #attachmentFileContainer{style: "display:none;"}
          %iframe#attachmentIframe{src: "", style: "width:100%; height:70vh; border:none;"}
      .modal-footer.border-0.pt-0.justify-content-end
        = link_to "Download", "#", class: "btn btn-outline-primary btn-sm", id: "attachmentDownloadLink", download: true
        %button.btn.btn-secondary.btn-sm{"data-bs-dismiss" => "modal", type: "button"} Close

:javascript
  document.getElementById('attachmentPreviewModal').addEventListener('show.bs.modal', function(event) {
    var trigger = event.relatedTarget;
    var url = trigger.getAttribute('data-attachment-url');
    var name = trigger.getAttribute('data-attachment-name');
    var isImage = trigger.getAttribute('data-attachment-image') === 'true';

    document.getElementById('attachmentDownloadLink').href = url;

    var imageContainer = document.getElementById('attachmentImageContainer');
    var fileContainer = document.getElementById('attachmentFileContainer');
    var img = document.getElementById('attachmentImage');
    var iframe = document.getElementById('attachmentIframe');
    if (isImage) {
      img.src = url;
      imageContainer.style.display = 'block';
      fileContainer.style.display = 'none';
      iframe.src = '';
    } else {
      iframe.src = url;
      fileContainer.style.display = 'block';
      imageContainer.style.display = 'none';
      img.src = '';
    }
  });

  document.getElementById('attachmentPreviewModal').addEventListener('hide.bs.modal', function() {
    document.getElementById('attachmentImage').src = '';
    document.getElementById('attachmentIframe').src = '';
  });

/ ── Close Ticket Modal ──────────────────────────────────────────
- if @ticket.status != "closed"
  #closeTicketModal.modal.fade{"aria-labelledby" => "closeTicketModalLabel", "aria-hidden" => "true", tabindex: "-1"}
    .modal-dialog.modal-dialog-centered
      .modal-content
        .modal-header.border-0.pb-0
        = form_with url: close_ticket_path(@ticket), method: :patch, local: true do |f|
          .modal-body
            .text-center.mb-3
              %i.bi.bi-check-circle.text-success{style: "font-size: 2.5rem;"}
              %p.mt-3.mb-1.fw-semibold Are you sure you want to close this ticket?
              %p.text-muted{style: "font-size: 13px;"}= "\"#{@ticket.title}\""
            - if current_user.admin? || current_user.agent?
              .mb-3
                %label.form-label.fw-bold.text-start.d-block Resolution
                = text_area_tag "resolution[how_resolved]", nil, rows: 3, class: "form-control", placeholder: "How was this resolved?"
          .modal-footer.border-0.pt-0.justify-content-center.gap-2
            %button.btn.btn-outline-secondary{"data-bs-dismiss" => "modal", type: "button"} Cancel
            = f.submit "Close Ticket", class: "btn btn-danger px-4"
