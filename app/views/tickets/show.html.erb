<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h5 class="mb-0">
      <%= @ticket.title %>
      <% if @ticket.on_behalf? %>
        <span class="badge bg-warning text-dark ms-2" style="font-size:11px;">
          On Behalf — created by <%= @ticket.created_by.fullname %>
        </span>
      <% end %>
    </h5>
    <small class="text-muted">
      #<%= @ticket.id %> &middot;
      <%= @ticket.ticket_type.humanize %> &middot;
      <%= @ticket.location&.name || "No location" %>
    </small>
  </div>
  <div class="d-flex gap-2">
    <% color = { "open" => "primary", "in_progress" => "warning", "closed" => "success", "cancelled" => "danger" } %>
    <span class="badge bg-<%= color[@ticket.status] %> fs-6"><%= @ticket.status.humanize %></span>

    <% if @ticket.status != "closed" && (current_user.admin? || current_user.agent? || @ticket.customer == current_user) %>
      <%= button_to "Close Ticket", close_ticket_path(@ticket), method: :patch, class: "btn btn-sm btn-outline-danger" %>
    <% end %>

    <% if (current_user.admin? || current_user.manager?) && @ticket.status != "closed" %>
      <button class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#assignForm">
        Assign
      </button>
    <% end %>

    <% if current_user.agent? && @ticket.assignee_id.nil? %>
      <%= button_to "Self Assign", self_assign_ticket_path(@ticket), method: :patch, class: "btn btn-sm btn-outline-success" %>
    <% end %>
  </div>
</div>

<!-- Assign Form — collapsible -->
<% if current_user.admin? || current_user.manager? %>
  <div class="collapse mb-3" id="assignForm">
    <div class="card card-body border-0 shadow-sm">
      <%= form_with url: assign_ticket_path(@ticket), method: :patch, local: true do |f| %>
        <div class="row g-2 align-items-end">
          <div class="col-md-5">
            <%= label_tag :assignee_id, "Assign to Agent", class: "form-label fw-bold" %>
            <%= select_tag :assignee_id,
                options_from_collection_for_select(User.agents.active, :id, :fullname, @ticket.assignee_id),
                class: "form-select", prompt: "Select agent" %>
          </div>
          <div class="col-md-5">
            <%= label_tag :reason, "Reason (optional)", class: "form-label fw-bold" %>
            <%= text_field_tag :reason, nil, class: "form-control", placeholder: "Reason for assignment" %>
          </div>
          <div class="col-md-2">
            <%= f.submit "Assign", class: "btn btn-primary w-100" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<div class="row g-3">

  <!-- Thread -->
  <div class="col-md-8">
    <div class="card border-0 shadow-sm mb-3">
      <div class="card-header bg-white fw-bold">Conversation</div>
      <div class="card-body">
        <% @ticket_details.each do |detail| %>
          <% next if detail.message_type == "internal_note" && current_user.customer? %>
          <div class="mb-3 p-3 rounded <%= detail.message_type == 'internal_note' ? 'bg-warning bg-opacity-10' : 'bg-light' %>">
            <div class="d-flex justify-content-between mb-1">
              <strong><%= detail.sender&.fullname || "System" %></strong>
              <small class="text-muted">
                <%= detail.created_at.strftime("%b %d, %Y %I:%M %p") %>
                <% if detail.message_type == "internal_note" %>
                  <span class="badge bg-warning text-dark ms-1">Internal Note</span>
                <% end %>
              </small>
            </div>
            <p class="mb-0"><%= detail.details %></p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Reply Form -->
    <% if @ticket.status != "closed" %>
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white fw-bold">Add Reply</div>
        <div class="card-body">
          <%= form_with url: ticket_ticket_details_path(@ticket), method: :post, local: true do |f| %>
            <%= f.text_area :details,
                rows: 4,
                class: "form-control mb-2",
                placeholder: "Write your reply here..." %>
            <% if current_user.admin? || current_user.agent? %>
              <div class="form-check mb-2">
                <%= check_box_tag "ticket_detail[message_type]", "internal_note", false, class: "form-check-input" %>
                <%= label_tag "internal_note_label", "Mark as internal note", class: "form-check-label text-muted" %>
              </div>
            <% end %>
            <%= f.submit "Send Reply", class: "btn btn-primary" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Ticket Info Sidebar -->
  <div class="col-md-4">
    <div class="card border-0 shadow-sm mb-3">
      <div class="card-header bg-white fw-bold">Ticket Info</div>
      <div class="card-body">
        <div class="mb-2">
          <small class="text-muted">Customer</small>
          <div><%= @ticket.customer&.fullname || "-" %></div>
        </div>
        <div class="mb-2">
          <small class="text-muted">Assignee</small>
          <div><%= @ticket.assignee&.fullname || "<span class='text-danger'>Unassigned</span>".html_safe %></div>
        </div>
        <div class="mb-2">
          <small class="text-muted">Assigned By</small>
          <div><%= @ticket.assigned_by&.fullname || "-" %></div>
        </div>
        <div class="mb-2">
          <small class="text-muted">Assigned At</small>
          <div><%= @ticket.assigned_at&.strftime("%b %d, %Y") || "-" %></div>
        </div>
        <div class="mb-2">
          <small class="text-muted">Resolved At</small>
          <div><%= @ticket.resolved_at&.strftime("%b %d, %Y") || "-" %></div>
        </div>
        <div class="mb-2">
          <small class="text-muted">Location</small>
          <div><%= @ticket.location&.name || "-" %></div>
        </div>
        <% if @ticket.on_behalf? %>
          <div class="mb-2">
            <small class="text-muted">Created By</small>
            <div>
              <%= @ticket.created_by.fullname %>
              <span class="badge bg-warning text-dark ms-1" style="font-size:10px;">On Behalf</span>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Assignment History -->
    <% if current_user.admin? || current_user.agent? || current_user.manager? %>
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white fw-bold">Assignment History</div>
        <div class="card-body p-0">
          <% @ticket_assignments.each do |a| %>
            <div class="px-3 py-2 border-bottom">
              <small class="text-muted"><%= a.created_at.strftime("%b %d, %Y") %></small>
              <div style="font-size:13px;">
                <% if a.assigned_from.present? %>
                  <span class="text-danger"><%= a.assigned_from.fullname %></span>
                  → <span class="text-success"><%= a.assigned_to.fullname %></span>
                <% else %>
                  Assigned to <span class="text-success"><%= a.assigned_to.fullname %></span>
                <% end %>
              </div>
              <% if a.reason.present? %>
                <small class="text-muted fst-italic"><%= a.reason %></small>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

  </div>
</div>
