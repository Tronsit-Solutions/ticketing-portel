%div{class: fld}
  %label{class: lbl}
    What Kind of Great Work would you like to call out ?
    %span{style: "color:#e02020;"} *
  - work_types = Array(ticket.metadata&.dig("work_types"))
  .mt-2
    - DropdownOption.for(DropdownOption::WORK_TYPES).each do |option|
      %label{style: "display:flex; align-items:center; gap:8px; font-size:14px; margin-bottom:10px; cursor:pointer;"}
        %input{type: "checkbox", name: "ticket[metadata][work_types][]", value: option.value, checked: work_types.include?(option.value), style: "width:16px; height:16px; cursor:pointer;"}
        = option.label
