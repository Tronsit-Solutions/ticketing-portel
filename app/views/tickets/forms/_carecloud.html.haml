%div{class: fld}
  = label_tag "ticket[metadata][issue]", "Issue", class: lbl
  = select_tag "ticket[metadata][issue]", |
    options_for_select(                   |
      DropdownOption.for(DropdownOption::CARECLOUD_ISSUE).pluck(:label, :value), |
      ticket.metadata&.dig("issue")       |
    ),                                     |
    class: sel, prompt: "Select an issue category"
