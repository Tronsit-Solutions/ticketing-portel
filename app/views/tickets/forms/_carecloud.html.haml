%div{class: fld}
  = label_tag "ticket[metadata][issue]", "Issue", class: lbl
  = select_tag "ticket[metadata][issue]", |
    options_for_select([                  |
      ["Select an issue category", ""],   |
      "Patient",                          |
      "Clinical",                         |
      "Reports",                          |
      "Document",                         |
      "Radiology",                        |
      "Ad-hoc reporting/IZENDA",          |
      "Billing Tasks",                    |
      "Settings",                         |
      "Scheduler",                        |
      "Provider Notes",                   |
      "KIOSK",                            |
      "Bugs/Glitches",                    |
      "Other"                             |
    ], ticket.metadata&.dig("issue")),    |
    class: sel                            |
