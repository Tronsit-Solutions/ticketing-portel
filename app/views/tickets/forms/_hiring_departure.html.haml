.cust-field
  %label.cust-form-label Is this a new hire or termination request ?
  = select_tag "ticket[metadata][request_type]", options_for_select([["Select Option", ""], "New Hire", "Termination"], ticket.metadata&.dig("request_type")), class: "cust-form-select"

.cust-field
  %label.cust-form-label Full Name :
  = text_field_tag "ticket[metadata][full_name]", ticket.metadata&.dig("full_name"), class: "cust-form-control", placeholder: ""

.cust-field
  %label.cust-form-label Which Location ?
  = select_tag "ticket[location_id]", options_from_collection_for_select(Location.active.ordered, :id, :name, ticket.location_id), class: "cust-form-select", prompt: "Select Option"
