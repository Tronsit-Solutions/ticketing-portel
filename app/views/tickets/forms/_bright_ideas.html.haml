%div{class: fld}
  %label{class: lbl}
    What Kind of Bright Idea do you have ?
    %span{style: "color:#e02020;"} *
  - idea_types = Array(ticket.metadata&.dig("idea_types"))
  .mt-2
    - DropdownOption.for(DropdownOption::IDEA_TYPES).each do |option|
      %label{style: "display:flex; align-items:center; gap:8px; font-size:14px; margin-bottom:10px; cursor:pointer;"}
        %input{type: "checkbox", name: "ticket[metadata][idea_types][]", value: option.value, checked: idea_types.include?(option.value), style: "width:16px; height:16px; cursor:pointer;"}
        = option.label
