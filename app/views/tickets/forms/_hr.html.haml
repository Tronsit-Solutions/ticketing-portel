%div{class: fld}
  %label{class: lbl}
    What Kind of HR Assistance do you need ?
    %span{style: "color:#e02020;"} *
  - hr_types = Array(ticket.metadata&.dig("hr_types"))
  - hr_options = DropdownOption.for(DropdownOption::HR_TYPES)
  .mt-2
    - hr_options.each do |option|
      %label{style: "display:flex; align-items:center; gap:8px; font-size:14px; margin-bottom:10px; cursor:pointer;"}
        %input{type: "checkbox", name: "ticket[metadata][hr_types][]", value: option.value, checked: hr_types.include?(option.value), style: "width:16px; height:16px; cursor:pointer; flex-shrink:0;"}
        = option.label
