:css
  .catalogue-entry {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 22px 28px;
    background: #ffffff;
    border: 1px solid #e8edf2;
    border-radius: 12px;
    text-decoration: none;
    color: #1a1a1a;
    transition: box-shadow 0.18s, border-color 0.18s, transform 0.12s;
    margin-bottom: 12px;
  }
  .catalogue-entry:hover {
    box-shadow: 0 4px 18px rgba(0,119,182,0.10);
    border-color: #0077b6;
    transform: translateY(-1px);
    color: #0077b6;
  }
  .catalogue-entry:hover .cat-icon-wrap { background: #0077b6; }
  .catalogue-entry:hover .cat-icon-wrap i { color: #fff; }
  .catalogue-entry:hover .cat-chevron { color: #0077b6; }
  .cat-icon-wrap {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #e8f4fb;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background 0.18s;
  }
  .cat-icon-wrap i { font-size: 22px; color: #0077b6; transition: color 0.18s; }
  .cat-body { flex: 1; }
  .cat-title { font-size: 16px; font-weight: 600; margin-bottom: 2px; }
  .cat-desc  { font-size: 13px; color: #6b7280; }
  .cat-chevron { font-size: 20px; color: #9ca3af; flex-shrink: 0; transition: color 0.18s; }
  .section-header {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: #9ca3af;
    margin-bottom: 16px;
    padding-left: 4px;
  }

- descriptions = { "technical_support" => "Get help with software, hardware, or system issues", "tronshealth" => "TronsHealth platform support and requests", "carecloud" => "CareCloud platform support and configuration requests", "curemd" => "CureMD platform support and configuration requests", "bright_ideas" => "Share a suggestion or improvement idea with the team", "great_work" => "Recognize a colleague for outstanding performance", "hr" => "Human resources inquiries, policies, and requests", "hiring_departure" => "Submit a request for a new hire or team member departure", "lms" => "Learning management system support and access requests" }

.mb-4
  %h4.fw-bold{style: "font-size: 22px;"} How can we help you?
  %p.text-muted{style: "font-size: 14px;"} Select a category below to create a new support ticket.

.section-header Service Categories

- @catalogue.each do |item|
  - if item[:children]
    .catalogue-entry{style: "cursor:default; flex-direction:column; align-items:flex-start; gap:12px;"}
      .d-flex.align-items-center.gap-3{style: "width:100%;"}
        .cat-icon-wrap
          %i{class: "bi #{item[:icon]}"}
        .cat-body
          .cat-title= item[:label]
        %i.bi.bi-chevron-right.cat-chevron
      .d-flex.flex-column.gap-1{style: "padding-left: 72px; width:100%;"}
        - item[:children].each do |child|
          = link_to new_ticket_path(ticket_type: child[:type]), style: "font-size:13px; color:#0077b6; text-decoration:none;" do
            = child[:label]
  - else
    = link_to new_ticket_path(ticket_type: item[:type]), class: "catalogue-entry" do
      .cat-icon-wrap
        %i{class: "bi #{item[:icon]}"}
      .cat-body
        .cat-title= item[:label]
        .cat-desc= descriptions[item[:type]]
      %i.bi.bi-chevron-right.cat-chevron
