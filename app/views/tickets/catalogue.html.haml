:css
  .tickets-layout {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 28px;
    align-items: start;
  }
  .panel-title {
    font-size: 15px;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 14px;
  }
  .category-chip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    background: #f3f4f6;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    text-decoration: none;
    color: #1a1a1a;
    font-size: 14px;
    font-weight: 500;
    transition: background 0.15s, border-color 0.15s;
  }
  .category-chip:hover { background: #e8f4fb; border-color: #0077b6; color: #0077b6; }
  .category-chip.active { background: #e8f4fb; border-color: #0077b6; color: #0077b6; font-weight: 600; }
  .category-chip .chip-count {
    background: #e5e7eb;
    color: #374151;
    border-radius: 20px;
    padding: 2px 10px;
    font-size: 13px;
    font-weight: 600;
  }
  .catalogue-panel {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    overflow: hidden;
  }
  .catalogue-panel-header {
    padding: 16px 22px;
    font-size: 13px;
    color: #6b7280;
    border-bottom: 1px solid #f0f0f0;
  }
  .catalogue-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 15px 22px;
    border-bottom: 1px solid #f3f4f6;
    text-decoration: none;
    color: #1a1a1a;
    font-size: 14px;
    font-weight: 500;
    transition: background 0.2s, padding 0.2s;
    cursor: pointer;
    position: relative;
  }
  .catalogue-row:last-child { border-bottom: none; }
  .catalogue-row:hover { background: #f0f8ff; color: #0077b6; }
  .catalogue-row i.cat-icon { font-size: 18px; color: #374151; width: 22px; text-align: center; flex-shrink: 0; transition: color 0.2s; }
  .catalogue-row:hover i.cat-icon { color: #0077b6; }
  .cat-row-body { display: flex; align-items: center; flex: 1; min-width: 0; }
  .cat-row-label { font-size: 14px; font-weight: 500; transition: color 0.2s; }
  .cat-row-desc {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: 12px;
    color: #6b7280;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .catalogue-row:hover .cat-row-desc { opacity: 1; }
  .cat-toggle { margin-left: auto; font-size: 12px; color: #6b7280; transition: transform 0.2s; flex-shrink: 0; }
  .catalogue-group.open .cat-toggle { transform: rotate(180deg); }
  .catalogue-children {
    display: none;
    background: #f9fafb;
    border-bottom: 1px solid #f3f4f6;
  }
  .catalogue-group.open .catalogue-children { display: block; }
  .catalogue-child-row {
    display: flex;
    align-items: center;
    padding: 11px 22px 11px 58px;
    font-size: 13px;
    color: #374151;
    text-decoration: none;
    border-bottom: 1px solid #f0f0f0;
    transition: background 0.2s, color 0.2s, padding 0.2s;
    position: relative;
  }
  .catalogue-child-row:last-child { border-bottom: none; }
  .catalogue-child-row:hover { background: #e8f4fb; color: #0077b6; }
  .cat-child-label { font-weight: 500; }
  .cat-child-desc {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: 11px;
    color: #9ca3af;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .catalogue-child-row:hover .cat-child-desc { opacity: 1; }

- if current_user.customer?
  .tickets-layout
    / Left — Categories
    .left-panel
      .panel-title Categories
      = link_to tickets_path, class: "category-chip" do
        %span My Tickets
        %span.chip-count= Ticket.where(customer: current_user).count

    / Right — Service Catalogue
    .right-panel
      .catalogue-panel
        .catalogue-panel-header
          To create a new ticket, kindly select a suitable service catalogue
        - @catalogue.each do |item|
          - if item[:children]
            .catalogue-group{"onclick" => "this.classList.toggle('open')"}
              .catalogue-row
                %i{class: "bi #{item[:icon]} cat-icon"}
                .cat-row-body
                  .cat-row-label= item[:label]
                  .cat-row-desc= item[:desc]
                %i.bi.bi-caret-down-fill.cat-toggle
              .catalogue-children
                - item[:children].each do |child|
                  = link_to new_ticket_path(ticket_type: child[:type]), class: "catalogue-child-row" do
                    .cat-child-label= child[:label]
                    .cat-child-desc= child[:desc]
          - else
            = link_to new_ticket_path(ticket_type: item[:type]), class: "catalogue-row" do
              %i{class: "bi #{item[:icon]} cat-icon"}
              .cat-row-body
                .cat-row-label= item[:label]
                .cat-row-desc= item[:desc]
- else
  .catalogue-panel
    .catalogue-panel-header
      To create a new ticket, kindly select a suitable service catalogue
    - @catalogue.each do |item|
      - if item[:children]
        .catalogue-group{"onclick" => "this.classList.toggle('open')"}
          .catalogue-row
            %i{class: "bi #{item[:icon]} cat-icon"}
            .cat-row-body
              .cat-row-label= item[:label]
              .cat-row-desc= item[:desc]
            %i.bi.bi-caret-down-fill.cat-toggle
          .catalogue-children
            - item[:children].each do |child|
              = link_to new_ticket_path(ticket_type: child[:type]), class: "catalogue-child-row" do
                .cat-child-label= child[:label]
                .cat-child-desc= child[:desc]
      - else
        = link_to new_ticket_path(ticket_type: item[:type]), class: "catalogue-row" do
          %i{class: "bi #{item[:icon]} cat-icon"}
          .cat-row-body
            .cat-row-label= item[:label]
            .cat-row-desc= item[:desc]
