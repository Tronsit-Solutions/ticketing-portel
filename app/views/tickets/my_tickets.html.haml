:css
  .tickets-layout {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 28px;
    align-items: start;
  }
  .panel-title {
    font-size: 15px;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 14px;
  }
  .category-chip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    background: #f3f4f6;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    text-decoration: none;
    color: #1a1a1a;
    font-size: 14px;
    font-weight: 500;
    transition: background 0.15s, border-color 0.15s;
  }
  .category-chip:hover { background: #e8f4fb; border-color: #0077b6; color: #0077b6; }
  .category-chip .chip-count {
    background: #e5e7eb;
    color: #374151;
    border-radius: 20px;
    padding: 2px 10px;
    font-size: 13px;
    font-weight: 600;
  }
  .ticket-list-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    overflow: hidden;
  }
  .ticket-list-tabs {
    display: flex;
    gap: 20px;
    padding: 14px 22px;
    border-bottom: 1px solid #f0f0f0;
    background: #f9fafb;
  }
  .ticket-tab-link {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 500;
    color: #6b7280;
    text-decoration: none;
  }
  .ticket-tab-link.active { color: #0077b6; font-weight: 600; }
  .ticket-tab-link .tab-count {
    background: #e5e7eb;
    color: #374151;
    border-radius: 20px;
    padding: 1px 9px;
    font-size: 12px;
    font-weight: 600;
  }
  .ticket-tab-link.active .tab-count { background: #d1e9f6; color: #0077b6; }
  .ticket-list-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 22px;
    border-bottom: 1px solid #f0f0f0;
    text-decoration: none;
    color: #1a1a1a;
    transition: background 0.15s;
  }
  .ticket-list-row:last-child { border-bottom: none; }
  .ticket-list-row:hover { background: #f5f9fd; }
  .ticket-row-title {
    font-size: 14px;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 3px;
  }
  .ticket-row-meta {
    font-size: 12px;
    color: #6b7280;
  }
  .ticket-status-badge {
    font-size: 12px;
    font-weight: 600;
    padding: 3px 12px;
    border-radius: 6px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .badge-open        { background: #f59e0b; color: #fff; }
  .badge-in-progress { background: #f59e0b; color: #fff; }
  .badge-closed      { background: #6b7280; color: #fff; }
  .badge-cancelled   { background: #ef4444; color: #fff; }
  .ticket-list-empty {
    text-align: center;
    padding: 48px 24px;
    color: #9ca3af;
    font-size: 14px;
  }

.tickets-layout
  / Left — Categories
  .left-panel
    .panel-title Categories
    = link_to my_tickets_tickets_path, class: "category-chip" do
      %span My Tickets
      %span.chip-count= @all_count

  / Right — Ticket List
  .right-panel
    .ticket-list-card
      .ticket-list-tabs
        = link_to my_tickets_tickets_path, class: "ticket-tab-link #{@active_tab == 'opened' ? 'active' : ''}" do
          %span Opened
          %span.tab-count= @open_tickets.count
        = link_to my_tickets_tickets_path(tab: "closed"), class: "ticket-tab-link #{@active_tab == 'closed' ? 'active' : ''}" do
          %span Closed
          %span.tab-count= @closed_tickets.count

      - if @listed_tickets.any?
        - @listed_tickets.each do |ticket|
          - badge_class = { "open" => "badge-open", "in_progress" => "badge-in-progress", "closed" => "badge-closed", "cancelled" => "badge-cancelled" }[ticket.status] || "badge-open"
          - badge_label = ticket.status == "in_progress" ? "Open" : ticket.status.humanize
          = link_to ticket_path(ticket), class: "ticket-list-row" do
            %div
              .ticket-row-title= ticket.title
              .ticket-row-meta
                \##{ticket.id} by #{ticket.customer&.email} was #{badge_label} on #{ticket.created_at.strftime("%b %-d, %Y")}
            %span{class: "ticket-status-badge #{badge_class}"}= badge_label
      - else
        .ticket-list-empty No tickets found.
