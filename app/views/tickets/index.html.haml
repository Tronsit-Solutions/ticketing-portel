.d-flex.justify-content-between.align-items-center.mb-4
  %h4.mb-0{style: "font-family: Poppins;"}
    - if params[:unassigned].present? || params[:assignment] == "unassigned"
      Unassigned Tickets
    - elsif params[:assignment] == "self_assigned"
      Self Assigned Tickets
    - elsif params[:status].present?
      = params[:status].humanize
      Tickets
    - else
      All Tickets

/ Filters
.card.border-0.shadow-sm.mb-4
  .card-body.py-2
    = form_with url: tickets_path, method: :get, local: true, class: "row g-2 align-items-end" do |f|
      .col-md-3
        = label_tag :search, "Search", class: "form-label mb-1 fw-bold"
        = text_field_tag :search, params[:search], class: "form-control form-control-sm", placeholder: "Search by title"
      .col-md-2
        = label_tag :status, "Status", class: "form-label mb-1 fw-bold"
        = select_tag :status, options_for_select([["All", ""], ["Open", "open"], ["In Progress", "in_progress"], ["Closed", "closed"], ["Cancelled", "cancelled"]], params[:status]), class: "form-select form-select-sm"
      .col-md-2
        = label_tag :ticket_type, "Type", class: "form-label mb-1 fw-bold"
        = select_tag :ticket_type, options_for_select([["All Types", ""]] + Ticket::TICKET_TYPES.map { |t| [t.humanize, t] }, params[:ticket_type]), class: "form-select form-select-sm"
      - unless current_user.customer?
        .col-md-2
          = label_tag :assignment, "Assignment", class: "form-label mb-1 fw-bold"
          - assignment_value = params[:unassigned].present? ? "unassigned" : params[:assignment]
          = select_tag :assignment, options_for_select([["All", ""], ["Unassigned only", "unassigned"], ["Self Assigned", "self_assigned"]], assignment_value), class: "form-select form-select-sm"
      .col-md-2
        = f.submit "Filter", class: "btn btn-outline-primary btn-sm w-100"
      .col-md-1
        = link_to "Clear", tickets_path, class: "btn btn-outline-secondary btn-sm w-100"

/ Tickets Table
.card.border-0.shadow-sm
  .card-body.p-0
    - if @tickets.any?
      %table.table.table-hover.mb-0
        %thead.table-light
          %tr
            %th #
            %th Title
            %th Type
            %th Status
            %th Location
            - unless current_user.customer?
              %th Customer
              %th Assignee
            %th Created
            %th
        %tbody
          - @tickets.each do |ticket|
            %tr
              %td.text-muted{style: "font-size:13px;"}
                \#{ticket.id}
              %td
                = link_to ticket.title, ticket_path(ticket), class: "text-dark text-decoration-none"
                - if ticket.on_behalf?
                  %span.badge.ms-1{style: "font-size:10px; background-color: #fdf2d0; color: #7d5a00;"} On Behalf
              %td
                %span
                  = ticket.ticket_type.humanize
              %td
                - color = { "open" => "primary", "in_progress" => "warning", "closed" => "success", "cancelled" => "danger" }
                %span{class: "badge bg-#{color[ticket.status]}"}= ticket.status.humanize
              %td= ticket.location&.name || "-"
              - unless current_user.customer?
                %td= ticket.customer&.fullname || "-"
                %td
                  - if ticket.assignee.present?
                    = ticket.assignee.fullname
                  - else
                    %span.text-danger Unassigned
                    - if current_user.agent?
                      = button_to "Grab", self_assign_ticket_path(ticket), method: :patch, class: "btn btn-xs btn-outline-success ms-1", style: "font-size:11px; padding: 1px 6px;"
              %td{style: "font-size:13px;"}= ticket.created_at.strftime("%b %d, %Y")
              %td= link_to "View", ticket_path(ticket), class: "btn btn-sm btn-outline-secondary"
    - else
      .text-center.text-muted.py-5
        %i.bi.bi-ticket-perforated{style: "font-size: 2rem;"}
        %p.mt-2 No tickets found.

- if @tickets.total_pages > 1
  .d-flex.justify-content-between.align-items-center.mt-3.px-1
    %small.text-muted
      Showing
      %strong= @tickets.offset_value + 1
      –
      %strong= [@tickets.offset_value + @tickets.limit_value, @tickets.total_count].min
      of
      %strong= @tickets.total_count
      tickets
    = paginate @tickets
