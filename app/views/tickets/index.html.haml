.d-flex.justify-content-between.align-items-center.mb-4
  %h4.mb-0{style: "font-family: Poppins;"}
    - if params[:unassigned].present? || params[:assignment] == "unassigned"
      Unassigned Tickets
    - elsif params[:assignment] == "self_assigned" || params[:assignee_id] == current_user.id.to_s
      My Tickets
    - elsif params[:status].present?
      = params[:status].humanize
      Tickets
    - else
      All Tickets
  - unless current_user.customer?
    = link_to catalogue_tickets_path, class: "btn btn-primary btn-sm" do
      + Generate Ticket

/ Filters
.card.filter-bar.border-0.shadow-sm.mb-4
  .card-body.py-2
    = form_with url: tickets_path, method: :get, local: true, class: "row g-2 align-items-end" do |f|
      = hidden_field_tag :unassigned, params[:unassigned] if params[:unassigned].present?
      = hidden_field_tag :assignee_id, params[:assignee_id] if params[:assignee_id].present?
      = hidden_field_tag :assignment, params[:assignment] if params[:assignment].present?
      .col-md-3
        = label_tag :search, "Search", class: "form-label mb-1 fw-bold"
        = text_field_tag :search, params[:search], class: "form-control form-control-sm", placeholder: "Search by title or ID"
      .col-md-2
        = label_tag :status, "Status", class: "form-label mb-1 fw-bold"
        = select_tag :status, options_for_select([["All", ""], ["Open", "open"], ["In Progress", "in_progress"], ["Closed", "closed"], ["Cancelled", "cancelled"]], params[:status]), class: "form-select form-select-sm"
      .col-md-2
        = label_tag :ticket_type, "Type", class: "form-label mb-1 fw-bold"
        - type_options = Ticket::TICKET_TYPES.map { |t| [Ticket::TYPE_LABELS[t] || t.humanize, t] }
        = select_tag :ticket_type, options_for_select([["All Types", ""]] + type_options.sort_by(&:first), params[:ticket_type]), class: "form-select form-select-sm"
      - unless current_user.customer?
        .col-md-2
          = label_tag :location_id, "Location", class: "form-label mb-1 fw-bold"
          = select_tag :location_id, options_for_select([["All Locations", ""]] + @locations.map { |l| [l.name, l.id] }, params[:location_id]), class: "form-select form-select-sm"
      .col-md-2
        = f.submit "Filter", class: "btn btn-outline-primary btn-sm w-100"
      .col-md-1
        - clear_params = params.slice(:unassigned, :assignee_id, :assignment).permit!
        = link_to "Clear", tickets_path(clear_params), class: "btn btn-outline-secondary btn-sm w-100"

/ Tickets Table
.card.border-0.shadow-sm
  .card-body.p-0
    - if @tickets.any?
      %table.table.table-hover.mb-0
        %thead.table-light
          %tr
            %th{style: "width: 6%;"}
              = link_to tickets_path(request.query_parameters.merge(sort: "id", direction: (@sort == "id" && @direction == "asc") ? "desc" : "asc")), class: "text-dark text-decoration-none" do
                ID
                - if @sort == "id"
                  %i.bi{class: @direction == "asc" ? "bi-arrow-up" : "bi-arrow-down"}
                - else
                  %i.bi.bi-arrow-down-up.text-muted{style: "font-size:11px;"}
            %th.text-center{style: "width: #{current_user.customer? ? 18 : 13}%;"}
              = link_to tickets_path(request.query_parameters.merge(sort: "title", direction: (@sort == "title" && @direction == "asc") ? "desc" : "asc")), class: "text-dark text-decoration-none" do
                Title
                - if @sort == "title"
                  %i.bi{class: @direction == "asc" ? "bi-arrow-up" : "bi-arrow-down"}
                - else
                  %i.bi.bi-arrow-down-up.text-muted{style: "font-size:11px;"}
            %th{style: "width: 9%;"} Type
            %th{style: "width: 9%;"} Status
            %th{style: "width: #{current_user.customer? ? 14 : 11}%;"} Location
            - unless current_user.customer?
              %th{style: "width: 12%;"} Customer
              %th{style: "width: 12%;"} Assignee
            %th{style: "width: 14%;"} Created
            %th{style: "width: 10%;"} Resolved In
            %th{style: "width: #{current_user.customer? ? 16 : 8}%;"}
        %tbody
          - @tickets.each do |ticket|
            %tr
              %td.text-muted{style: "font-size:13px;"}
                \#{ticket.id}
              %td.text-center
                .d-flex.flex-column.align-items-center{style: "min-width: 0;"}
                  %span.tooltip-wrap{style: "max-width: 100%;", data: {tooltip: ticket.title}}
                    = link_to ticket.title, ticket_path(ticket), class: "text-dark text-decoration-none text-truncate-cell"
                  - if ticket.on_behalf?
                    %span.badge.mt-1{style: "font-size:10px; background-color: #fdf2d0; color: #7d5a00;"} On Behalf
              %td
                %span
                  = ticket.type_label
              %td
                - color = { "open" => "primary", "in_progress" => "warning", "closed" => "success", "cancelled" => "danger" }
                %span{class: "badge bg-#{color[ticket.status]}"}= ticket.status.humanize
              %td
                %span.tooltip-wrap{data: {tooltip: ticket.location&.name}}
                  %span.text-truncate-cell= ticket.location&.name || "-"
              - unless current_user.customer?
                %td
                  %span.tooltip-wrap{data: {tooltip: ticket.customer&.fullname}}
                    %span.text-truncate-cell= ticket.customer&.fullname || "-"
                %td
                  - if ticket.assignee.present?
                    %span.tooltip-wrap{data: {tooltip: ticket.assignee.fullname}}
                      %span.text-truncate-cell= ticket.assignee.fullname
                  - else
                    %span.text-danger Unassigned
                    - if current_user.agent? && ticket.status != "cancelled"
                      = button_to "Grab", self_assign_ticket_path(ticket), method: :patch, class: "btn btn-xs btn-outline-success ms-1", style: "font-size:11px; padding: 1px 6px;"
              %td{style: "font-size:13px;"}= ticket.created_at.strftime("%b %d, %Y %I:%M %p")
              %td{style: "font-size:13px;"}= ticket.resolution_duration || "-"
              %td= link_to "View", ticket_path(ticket), class: "btn btn-sm btn-outline-secondary"
    - else
      .text-center.text-muted.py-5
        %i.bi.bi-ticket-perforated{style: "font-size: 2rem;"}
        %p.mt-2 No tickets found.

- if @tickets.total_pages > 1
  .d-flex.justify-content-between.align-items-center.mt-3.px-1
    %small.text-muted
      Showing
      %strong= @tickets.offset_value + 1
      –
      %strong= [@tickets.offset_value + @tickets.limit_value, @tickets.total_count].min
      of
      %strong= @tickets.total_count
      tickets
    = paginate @tickets
