= render "shared/customer/tickets_layout_styles"
= render "shared/customer/catalogue_panel_styles"

.tickets-layout
  = render "shared/customer/ticket_categories", active: @active_panel, my_tickets_count: @all_count

  .right-panel
    - if @active_panel == :my_tickets
      .ticket-list-card
        = render "shared/customer/ticket_list_items", active_tab: @active_tab, open_tickets_count: @open_tickets_count, closed_tickets_count: @closed_tickets_count, listed_tickets: @listed_tickets

      - if @listed_tickets.any?
        .ticket-list-pagination.mt-3.d-flex.justify-content-center
          = paginate @listed_tickets, params: { tab: @active_tab }
    - else
      .catalogue-panel
        .catalogue-panel-header
          To create a new ticket, kindly select a suitable service catalogue
        = render "shared/customer/catalogue_items", catalogue: @catalogue
