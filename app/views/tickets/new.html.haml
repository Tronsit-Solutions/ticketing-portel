- if current_user.customer?
  :css
    .new-ticket-layout {
      display: grid;
      grid-template-columns: 300px 1fr;
      gap: 28px;
      align-items: start;
    }
    .panel-title {
      font-size: 15px;
      font-weight: 600;
      color: #1a1a1a;
      margin-bottom: 14px;
    }
    .category-chip {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 18px;
      background: #f3f4f6;
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      text-decoration: none;
      color: #1a1a1a;
      font-size: 14px;
      font-weight: 500;
      transition: background 0.15s, border-color 0.15s;
    }
    .category-chip:hover { background: #e8f4fb; border-color: #0077b6; color: #0077b6; }
    .category-chip .chip-count {
      background: #e5e7eb;
      color: #374151;
      border-radius: 20px;
      padding: 2px 10px;
      font-size: 13px;
      font-weight: 600;
    }
    .form-header {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 18px;
      font-weight: 700;
      color: #1a1a1a;
      margin-bottom: 24px;
    }
    .form-header-back {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      background: #1a1a1a;
      color: #fff;
      border-radius: 6px;
      text-decoration: none;
      font-size: 15px;
      flex-shrink: 0;
      transition: background 0.15s;
    }
    .form-header-back:hover { background: #0077b6; color: #fff; }
    .cust-form-label {
      font-size: 14px;
      font-weight: 600;
      color: #1a1a1a;
      margin-bottom: 6px;
      display: block;
    }
    .cust-form-control, .cust-form-select {
      width: 100%;
      border: 1px solid #dde2ea;
      border-radius: 8px;
      font-size: 14px;
      padding: 10px 14px;
      color: #1a1a1a;
      background: #fafbfc;
      transition: border-color 0.15s, box-shadow 0.15s;
      outline: none;
    }
    .cust-form-control:focus, .cust-form-select:focus {
      border-color: #0077b6;
      box-shadow: 0 0 0 3px rgba(0,119,182,0.10);
      background: #fff;
    }
    textarea.cust-form-control { resize: vertical; min-height: 200px; }
    .cust-field { margin-bottom: 20px; }
    .upload-zone {
      border: 1px solid #dde2ea;
      border-radius: 8px;
      padding: 20px 24px;
      text-align: center;
      background: #f3f4f6;
      cursor: pointer;
      font-size: 14px;
      color: #6b7280;
      transition: border-color 0.15s;
    }
    .upload-zone:hover { border-color: #0077b6; }
    .upload-zone a { color: #0077b6; font-weight: 500; text-decoration: underline; cursor: pointer; }
    .file-chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #e8f4fb;
      border: 1px solid #b3d7ee;
      border-radius: 20px;
      padding: 4px 12px;
      font-size: 12px;
      margin: 3px;
      color: #0077b6;
    }
    .cust-submit-row {
      display: flex;
      justify-content: flex-end;
      margin-top: 8px;
    }
    .btn-cust-submit {
      background: #0077b6;
      color: #fff;
      border: none;
      border-radius: 8px;
      padding: 10px 32px;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.15s;
    }
    .btn-cust-submit:hover { background: #005f8e; }

  .new-ticket-layout
    / Left — Categories
    .left-panel
      .panel-title Categories
      = link_to tickets_path, class: "category-chip" do
        %span My Tickets
        %span.chip-count= @my_tickets_count

    / Right — Form
    .right-panel
      .form-header
        = link_to catalogue_tickets_path, class: "form-header-back", "aria-label" => "Back" do
          %i.bi.bi-arrow-left
        - if @ticket_type
          - form_header_labels = { "lms" => "Password Reset for LMS" }
          = form_header_labels[@ticket.ticket_type] || @ticket_type[:label]
        - else
          New Ticket

      = form_with model: @ticket, local: true, multipart: true do |f|
        = f.hidden_field :ticket_type, value: @ticket.ticket_type
        = render "tickets/ticket_fields", f: f, ticket: @ticket, css_class: "cust", show_customer_selector: false

        .cust-submit-row
          = f.submit "Submit", class: "btn-cust-submit"

  :javascript
    function showFileNames(input) {
      const list = document.getElementById('fileList');
      list.innerHTML = '';
      Array.from(input.files).forEach(function(file) {
        const chip = document.createElement('span');
        chip.className = 'file-chip';
        chip.innerHTML = '<i class="bi bi-paperclip"></i>' + file.name;
        list.appendChild(chip);
      });
    }

- else
  :css
    .ticket-form-wrap
    .form-back-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: #6b7280;
      font-size: 14px;
      text-decoration: none;
      margin-bottom: 24px;
      transition: color 0.15s;
    }
    .form-back-link:hover { color: #0077b6; }
    .ticket-type-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #e8f4fb;
      color: #0077b6;
      border-radius: 20px;
      padding: 5px 14px;
      font-size: 13px;
      font-weight: 500;
      margin-bottom: 20px;
    }
    .form-card {
      background: #ffffff;
      border: 1px solid #e8edf2;
      border-radius: 14px;
      padding: 36px 40px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    }
    .form-label {
      font-size: 13px;
      font-weight: 600;
      color: #374151;
      margin-bottom: 6px;
      display: block;
    }
    .form-control, .form-select {
      border: 1px solid #dde2ea;
      border-radius: 8px;
      font-size: 14px;
      padding: 10px 14px;
      color: #1a1a1a;
      background: #fafbfc;
      transition: border-color 0.15s, box-shadow 0.15s;
    }
    .form-control:focus, .form-select:focus {
      border-color: #0077b6;
      box-shadow: 0 0 0 3px rgba(0,119,182,0.10);
      background: #fff;
    }
    textarea.form-control { resize: vertical; min-height: 120px; }
    .mb-3 { margin-bottom: 20px; }
    .upload-zone {
      border: 1px solid #dde2ea;
      border-radius: 8px;
      padding: 20px 24px;
      text-align: center;
      background: #f3f4f6;
      cursor: pointer;
      font-size: 14px;
      color: #6b7280;
      transition: border-color 0.15s;
    }
    .upload-zone:hover { border-color: #0077b6; }
    .upload-zone a { color: #0077b6; font-weight: 500; text-decoration: underline; cursor: pointer; }
    .file-chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #e8f4fb;
      border: 1px solid #b3d7ee;
      border-radius: 20px;
      padding: 4px 12px;
      font-size: 12px;
      margin: 3px;
      color: #0077b6;
    }
    .btn-submit {
      background: #0077b6;
      color: #fff;
      border: none;
      border-radius: 8px;
      padding: 11px 32px;
      font-size: 15px;
      font-weight: 600;
      transition: background 0.15s, box-shadow 0.15s;
    }
    .btn-submit:hover { background: #005f8e; color: #fff; box-shadow: 0 3px 10px rgba(0,119,182,0.25); }
    .btn-cancel {
      background: #f3f4f6;
      color: #374151;
      border: 1px solid #e0e3e8;
      border-radius: 8px;
      padding: 11px 24px;
      font-size: 15px;
      font-weight: 500;
      transition: background 0.15s;
    }
    .btn-cancel:hover { background: #e8edf2; color: #1a1a1a; }

  .ticket-form-wrap
    = link_to catalogue_tickets_path, class: "form-back-link" do
      %i.bi.bi-arrow-left
      Back to categories

    - if @ticket_type
      .ticket-type-badge
        %i{class: "bi #{@ticket_type[:icon]}"}
        = @ticket_type[:label]

    %h4.fw-bold.mb-1{style: "font-size: 20px;"} Create Ticket On Behalf
    %p.text-muted.mb-4{style: "font-size: 14px;"} Fill in the details below and we'll get back to you as soon as possible.

    .form-card
      = form_with model: @ticket, local: true, multipart: true do |f|
        = f.hidden_field :ticket_type, value: @ticket.ticket_type
        = render "tickets/ticket_fields",
            f: f,
            ticket: @ticket,
            css_class: "std",
            show_customer_selector: true,
            customers: @customers

        .d-flex.align-items-center.gap-3.mt-4.pt-2
          = f.submit "Submit On Behalf", class: "btn btn-submit"
          = link_to "Cancel", catalogue_tickets_path, class: "btn btn-cancel"

  :javascript
    function showFileNames(input) {
      const list = document.getElementById('fileList');
      list.innerHTML = '';
      Array.from(input.files).forEach(function(file) {
        const chip = document.createElement('span');
        chip.className = 'file-chip';
        chip.innerHTML = '<i class="bi bi-paperclip"></i>' + file.name;
        list.appendChild(chip);
      });
    }
