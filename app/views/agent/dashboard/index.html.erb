<h4 class="mb-4" style="font-family: Poppins;">Agent Dashboard</h4>

<!-- Stat Cards -->
<div class="row g-3 mb-4">

  <div class="col-md-4">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="text-muted" style="font-size:13px;">Assigned to Me</div>
        <div class="fs-3 fw-bold text-warning"><%= @assigned_tickets %></div>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="text-muted" style="font-size:13px;">Unassigned Pool</div>
        <div class="fs-3 fw-bold text-danger"><%= @unassigned_tickets %></div>
        <%= link_to "Pick a ticket", tickets_path(unassigned: true), class: "btn btn-sm btn-outline-danger mt-2" %>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="text-muted" style="font-size:13px;">Closed by Me</div>
        <div class="fs-3 fw-bold text-success"><%= @closed_tickets %></div>
      </div>
    </div>
  </div>

</div>

<!-- My Tickets Table -->
<div class="card border-0 shadow-sm">
  <div class="card-header bg-white d-flex justify-content-between align-items-center">
    <span class="fw-bold">My Assigned Tickets</span>
    <%= link_to "View All", tickets_path(assignee_id: current_user.id), class: "btn btn-sm btn-outline-primary" %>
  </div>
  <div class="card-body p-0">
    <table class="table table-hover mb-0">
      <thead class="table-light">
        <tr>
          <th>#</th>
          <th>Title</th>
          <th>Type</th>
          <th>Status</th>
          <th>Customer</th>
          <th>Created</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @my_tickets.each do |ticket| %>
          <tr>
            <td><%= ticket.id %></td>
            <td><%= link_to ticket.title, ticket_path(ticket), class: "text-dark text-decoration-none" %></td>
            <td><span class="badge bg-secondary"><%= ticket.ticket_type.humanize %></span></td>
            <td>
              <% color = { "open" => "primary", "in_progress" => "warning", "closed" => "success", "cancelled" => "danger" } %>
              <span class="badge bg-<%= color[ticket.status] %>"><%= ticket.status.humanize %></span>
            </td>
            <td><%= ticket.customer&.fullname || "-" %></td>
            <td><%= ticket.created_at.strftime("%b %d, %Y") %></td>
            <td><%= link_to "View", ticket_path(ticket), class: "btn btn-sm btn-outline-secondary" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
