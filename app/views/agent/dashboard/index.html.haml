/ Stat Cards
.row.g-3.mb-4
  .col-md-4
    .card.border-0.shadow-sm
      .card-body
        .text-muted{:style => "font-size:13px;"} My Tickets
        .fs-3.fw-bold.text-warning= @assigned_tickets
  .col-md-4
    .card.border-0.shadow-sm
      .card-body
        .text-muted{:style => "font-size:13px;"} Unassigned Pool
        .d-flex.align-items-center.gap-3
          .fs-3.fw-bold.text-danger= @unassigned_tickets
          = link_to "Pick a ticket", tickets_path(unassigned: true), class: "btn btn-sm btn-outline-danger"
  .col-md-4
    .card.border-0.shadow-sm
      .card-body
        .text-muted{:style => "font-size:13px;"} Closed by Me
        .fs-3.fw-bold.text-success= @closed_tickets
/ My Tickets Table
.card.border-0.shadow-sm
  .card-header.bg-white.d-flex.justify-content-between.align-items-center
    %span.fw-bold My Assigned Tickets
    = link_to "View All", tickets_path, class: "btn btn-sm btn-outline-primary"
  .card-body.p-0
    %table.table.table-hover.mb-0
      %thead.table-light
        %tr
          %th{style: "width: 5%;"}
          %th{style: "width: 22%;"} Title
          %th{style: "width: 11%;"} Type
          %th{style: "width: 11%;"} Status
          %th{style: "width: 14%;"} Location
          %th{style: "width: 16%;"} Customer
          %th{style: "width: 14%;"} Created
          %th{style: "width: 7%;"}
      %tbody
        - @my_tickets.each do |ticket|
          %tr
            %td= ticket.id
            %td
              %span.tooltip-wrap{data: {tooltip: ticket.title}}
                = link_to ticket.title, ticket_path(ticket), class: "text-dark text-decoration-none text-truncate-cell"
            %td
              %span
              = ticket.type_label
            %td
              - color = { "open" => "primary", "in_progress" => "warning", "closed" => "success", "cancelled" => "danger" }
              %span{:class => "badge bg-#{color[ticket.status]}"}= ticket.status.humanize
            %td
              %span.tooltip-wrap{data: {tooltip: ticket.location&.name}}
                %span.text-truncate-cell= ticket.location&.name || "-"
            %td
              %span.tooltip-wrap{data: {tooltip: ticket.customer&.fullname}}
                %span.text-truncate-cell= ticket.customer&.fullname || "-"
            %td= ticket.created_at.strftime("%b %d, %Y %I:%M %p")
            %td= link_to "View", ticket_path(ticket), class: "btn btn-sm btn-outline-secondary"
