- if message.structured_data.present?
  - msg_modal_rows = [{ label: "Date", value: message.created_at.strftime("%B %-d, %Y at %-I:%M %p") }]
  - message.structured_data.each { |k, v| display = v.is_a?(Array) ? v.join(", ") : v.to_s; msg_modal_rows << { label: k.to_s.titleize, value: display } if display.present? && display.downcase != "none" }
  - msg_modal_json = "[#{msg_modal_rows.map { |r| "{label:#{r[:label].to_json},value:#{r[:value].to_json}}" }.join(",")}]"
- else
  - msg_modal_json = "[{label:\"Date\",value:#{message.created_at.strftime('%B %-d, %Y at %-I:%M %p').to_json}},{label:\"Message\",value:#{message.details.to_json}}]"
.ticket-message-block
  .ticket-msg-header
    .ticket-msg-date= message.created_at.strftime("%B %-d, %Y at %-I:%M %p")
    %button.folder-btn{"onclick" => "openMsgModal(#{msg_modal_json})", "type" => "button", "aria-label" => "View message"}
      %i.bi.bi-folder2-open
  - if message.structured_data.present?
    = render "shared/structured_message", data: message.structured_data
  - else
    .ticket-msg-text= message.details
