-# Also rendered by TicketMessage#broadcast_created, so it can't rely on current_user.
- sender   = message.sender
- staff    = sender.present? && !sender.customer?
- initials = sender ? (sender.fullname.to_s.split.first(2).map { |part| part[0] }.join.upcase.presence || sender.email.to_s.first.to_s.upcase) : "S"
%div{class: ["ticket-msg", staff ? "from-staff" : "from-customer", ("is-internal" if message.internal_note?)]}
  .ticket-msg-avatar= initials
  .ticket-msg-body
    .ticket-msg-head
      %strong= sender&.fullname || "System"
      - if sender
        %span.ticket-msg-role= sender.role.humanize
      %span.ticket-msg-time{title: message.created_at.strftime("%b %d, %Y %I:%M %p")}= message.created_at.strftime("%b %d, %Y %I:%M %p")
      - if message.internal_note?
        %span.badge.bg-warning.text-dark
          %i.bi.bi-eye-slash.me-1
          Internal Note
    .ticket-msg-bubble
      - if message.structured_data.present?
        = render "shared/structured_message", data: message.structured_data
      - else
        %p.mb-0= message.details
