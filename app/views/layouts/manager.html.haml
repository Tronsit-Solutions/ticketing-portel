!!!
%html
  %head
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %title Manager Portal | Ticketing
    %meta{:content => "width=device-width, initial-scale=1", :name => "viewport"}/
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_link_tag "application", "data-turbo-track": "reload"
    %link{:href => "https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css", :rel => "stylesheet"}/
    = javascript_importmap_tags
    :css
      body        { background-color: #f4f6f9; }
      .sidebar    { min-height: 100vh; background-color: #023e8a; width: 250px; position: fixed; top: 0; left: 0; padding-top: 70px; }
      .sidebar a  { color: #ffffff; display: block; padding: 12px 20px; text-decoration: none; font-size: 15px; }
      .sidebar a:hover      { background-color: #012f6b; }
      .sidebar .nav-section { color: #90e0ef; font-size: 11px; padding: 16px 20px 4px; text-transform: uppercase; letter-spacing: 1px; }
      .main-content         { margin-left: 250px; padding: 80px 24px 24px; }
      .navbar               { background-color: #023e8a; position: fixed; top: 0; width: 100%; z-index: 1000; }
      .navbar-brand         { color: #fff !important; font-weight: bold; font-size: 18px; }
      .nav-link             { color: #fff !important; }
  %body
    / Navbar
    %nav.navbar.navbar-expand-lg.px-4
      %span.navbar-brand Ticketing Portal
      %span.text-white.ms-2.opacity-75{:style => "font-size:13px;"} Manager
      .ms-auto.d-flex.align-items-center.gap-3
        %a.nav-link.position-relative{:href => ticket_notifications_path}
          %i.bi.bi-bell-fill
          - unread = TicketNotification.for_user(current_user).unread.count
          - if unread > 0
            %span.badge.bg-danger.position-absolute.top-0.start-100.translate-middle
              = unread
        %span.text-white= current_user.fullname
        = link_to "Logout", destroy_user_session_path, data: { turbo_method: :delete }, class: "nav-link"
    / Sidebar
    .sidebar
      .nav-section Main
      = link_to "Dashboard", manager_root_path
      .nav-section Tickets
      = link_to "All Tickets",    tickets_path
      = link_to "Open",           tickets_path(status: "open")
      = link_to "Assigned to Me", tickets_path(assignee_id: current_user.id)
      = link_to "Create On Behalf", catalogue_tickets_path
      .nav-section Team
      = link_to "My Team Members", users_path(team_id: current_user.team_id)
    / Main Content
    .main-content
      = render "shared/flash"
      = yield
