<!DOCTYPE html>
<html>
  <head>
    <title>Support Portal | Ticketing</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <%= javascript_importmap_tags %>
    <style>
      body          { background-color: #f4f6f9; }
      .main-content { padding: 80px 24px 24px; }
      .navbar       { background-color: #0077b6; position: fixed; top: 0; width: 100%; z-index: 1000; }
      .navbar-brand { color: #fff !important; font-weight: bold; font-size: 18px; }
      .nav-link     { color: #fff !important; }
    </style>
  </head>

  <body>

    <!-- Navbar only — no sidebar for customer -->
    <nav class="navbar navbar-expand-lg px-4">
      <span class="navbar-brand">Support Portal</span>
      <div class="ms-auto d-flex align-items-center gap-3">
        <%= link_to "My Tickets",  tickets_path,     class: "nav-link" %>
        <%= link_to "New Ticket",  new_ticket_path,  class: "nav-link" %>
        <a href="<%= ticket_notifications_path %>" class="nav-link position-relative">
          <i class="bi bi-bell-fill"></i>
          <% unread = TicketNotification.for_user(current_user).unread.count %>
          <% if unread > 0 %>
            <span class="badge bg-danger position-absolute top-0 start-100 translate-middle">
              <%= unread %>
            </span>
          <% end %>
        </a>
        <span class="text-white"><%= current_user.fullname %></span>
        <%= link_to "Logout", destroy_user_session_path, data: { turbo_method: :delete }, class: "nav-link" %>
      </div>
    </nav>

    <!-- Main Content -->
    <div class="main-content container">
      <%= render "shared/flash" %>
      <%= yield %>
    </div>

  </body>
</html>
