!!!
%html
  %head
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %title Customer Portal | Ticketing
    %meta{:content => "width=device-width, initial-scale=1", :name => "viewport"}/
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_link_tag "application", "data-turbo-track": "reload"
    %link{:href => "https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css", :rel => "stylesheet"}/
    = javascript_importmap_tags
    :css
      * { box-sizing: border-box; }

      body {
        background-color: #f0f2f5;
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      }

      .top-navbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 56px;
        background-color: #0077b6;
        display: flex;
        align-items: center;
        padding: 0 20px;
        z-index: 1100;
      }

      .top-navbar .brand {
        color: #ffffff;
        font-size: 18px;
        font-weight: 600;
        letter-spacing: 0.5px;
      }

      .top-navbar .dropdown {
        margin-left: auto;
      }

      .top-navbar .ticket-actions-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        background: none;
        border: 1px solid rgba(255,255,255,0.4);
        border-radius: 8px;
        color: #ffffff;
        font-size: 16px;
        cursor: pointer;
        transition: background 0.15s, border-color 0.15s;
      }
      .top-navbar .ticket-actions-toggle:hover { background: rgba(255,255,255,0.12); border-color: #ffffff; }
      .top-navbar .ticket-actions-toggle::after { display: none; }

      .sidebar {
        width: 280px;
        min-height: 100vh;
        background-color: #ffffff;
        position: fixed;
        top: 56px;
        left: 0;
        bottom: 0;
        border-right: 1px solid #e5e7eb;
        z-index: 1000;
        overflow-y: auto;
      }

      .sidebar-logo-wrap {
        padding: 28px 20px;
        border-bottom: 1px solid #e5e7eb;
        text-align: center;
      }

      .sidebar-logo-wrap img {
        max-width: 180px;
        max-height: 72px;
        object-fit: contain;
      }

      .sidebar-nav a {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px 24px;
        color: #1a1a1a;
        font-size: 15px;
        font-weight: 500;
        text-decoration: none;
        border-bottom: 1px solid #f0f0f0;
        transition: background 0.15s;
      }

      .sidebar-nav a:hover {
        background-color: #e8f4fb;
        color: #0077b6;
      }

      .sidebar-nav a i {
        font-size: 20px;
        width: 24px;
        text-align: center;
        color: #374151;
        flex-shrink: 0;
      }

      .sidebar-nav a:hover i { color: #0077b6; }

      .main-content {
        margin-left: 280px;
        padding: 80px 32px 32px;
        min-height: 100vh;
      }

  %body

    / Topbar
    .top-navbar
      .brand Customer Portal

      - if @ticket.present? && @ticket.persisted? && @ticket.status.in?(%w[open in_progress])
        .dropdown
          %button.ticket-actions-toggle{type: "button", "data-bs-toggle" => "dropdown", "aria-expanded" => "false", "aria-label" => "Ticket actions"}
            %i.bi.bi-three-dots-vertical
          %ul.dropdown-menu.dropdown-menu-end
            %li
              %button.dropdown-item{type: "button", "data-bs-toggle" => "modal", "data-bs-target" => "#sendMessageModal"} Send Message
            %li
              %button.dropdown-item.text-danger{type: "button", "data-bs-toggle" => "modal", "data-bs-target" => "#cancelTicketModal"} Cancel Ticket

    / Sidebar
    .sidebar

      .sidebar-logo-wrap
        = image_tag "akpc.png", alt: "AKPC Logo"

      .sidebar-nav
        = link_to customer_root_path do
          %i.bi.bi-person-fill
          Customer Support

        = link_to catalogue_tickets_path do
          %i.bi.bi-ticket-perforated-fill
          Tickets

        = turbo_stream_from current_user, :ticket_notifications
        = link_to ticket_notifications_path do
          %i.bi.bi-bell-fill
          Notifications
          = render "shared/notification_bell_badge", user: current_user, badge_class: "ms-auto", badge_style: nil

        = link_to customer_wiki_path do
          %i.bi.bi-people-fill
          Wiki

        = link_to destroy_user_session_path, data: { turbo_method: :delete } do
          %i.bi.bi-power
          Logout

    / Main Content
    .main-content
      = render "shared/flash"
      = yield
