!!!
%html
  %head
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %title Support Portal | Ticketing
    %meta{:content => "width=device-width, initial-scale=1", :name => "viewport"}/
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_link_tag "application", "data-turbo-track": "reload"
    %link{:href => "https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css", :rel => "stylesheet"}/
    = javascript_importmap_tags
    :css
      body          { background-color: #f4f6f9; }
      .main-content { padding: 80px 24px 24px; }
      .navbar       { background-color: #0077b6; position: fixed; top: 0; width: 100%; z-index: 1000; }
      .navbar-brand { color: #fff !important; font-weight: bold; font-size: 18px; }
      .nav-link     { color: #fff !important; }
  %body
    / Navbar only — no sidebar for customer
    %nav.navbar.navbar-expand-lg.px-4
      %span.navbar-brand Support Portal
      .ms-auto.d-flex.align-items-center.gap-3
        = link_to "My Tickets",  tickets_path,     class: "nav-link"
        = link_to "New Ticket",  new_ticket_path,  class: "nav-link"
        %a.nav-link.position-relative{:href => ticket_notifications_path}
          %i.bi.bi-bell-fill
          - unread = TicketNotification.for_user(current_user).unread.count
          - if unread > 0
            %span.badge.bg-danger.position-absolute.top-0.start-100.translate-middle
              = unread
        %span.text-white= current_user.fullname
        = link_to "Logout", destroy_user_session_path, data: { turbo_method: :delete }, class: "nav-link"
    / Main Content
    .main-content.container
      = render "shared/flash"
      = yield
