<!DOCTYPE html>
<html>
  <head>
    <title>Admin Portal | Ticketing</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <%= javascript_importmap_tags %>
    <style>
      body        { background-color: #f4f6f9; }
      .sidebar    { min-height: 100vh; background-color: #0077b6; width: 250px; position: fixed; top: 0; left: 0; padding-top: 70px; }
      .sidebar a  { color: #ffffff; display: block; padding: 12px 20px; text-decoration: none; font-size: 15px; }
      .sidebar a:hover      { background-color: #005f99; }
      .sidebar .nav-section { color: #90e0ef; font-size: 11px; padding: 16px 20px 4px; text-transform: uppercase; letter-spacing: 1px; }
      .main-content         { margin-left: 250px; padding: 80px 24px 24px; }
      .navbar               { background-color: #0077b6; position: fixed; top: 0; width: 100%; z-index: 1000; }
      .navbar-brand         { color: #fff !important; font-weight: bold; font-size: 18px; }
      .nav-link             { color: #fff !important; }
    </style>
  </head>

  <body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg px-4">
      <span class="navbar-brand">Ticketing Portal</span>
      <span class="text-white ms-2 opacity-75" style="font-size:13px;">Admin</span>
      <div class="ms-auto d-flex align-items-center gap-3">
        <a href="<%= ticket_notifications_path %>" class="nav-link position-relative">
          <i class="bi bi-bell-fill"></i>
          <% unread = TicketNotification.for_user(current_user).unread.count %>
          <% if unread > 0 %>
            <span class="badge bg-danger position-absolute top-0 start-100 translate-middle">
              <%= unread %>
            </span>
          <% end %>
        </a>
        <span class="text-white"><%= current_user.fullname %></span>
        <%= link_to "Logout", destroy_user_session_path, data: { turbo_method: :delete }, class: "nav-link" %>
      </div>
    </nav>

    <!-- Sidebar -->
    <div class="sidebar">

      <div class="nav-section">Main</div>
      <%= link_to "Dashboard", admin_root_path %>

      <div class="nav-section">Tickets</div>
      <%= link_to "All Tickets",  tickets_path %>
      <%= link_to "Open",         tickets_path(status: "open") %>
      <%= link_to "Unassigned",   tickets_path(unassigned: true) %>
      <%= link_to "Closed",       tickets_path(status: "closed") %>

      <div class="nav-section">Users</div>
      <%= link_to "All Users", users_path %>
      <%= link_to "Add User",  new_user_path %>

    </div>

    <!-- Main Content -->
    <div class="main-content">
      <%= render "shared/flash" %>
      <%= yield %>
    </div>

  </body>
</html>
