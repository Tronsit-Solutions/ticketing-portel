#flash-container
  - if notice
    .flash-alert.alert.alert-success.alert-dismissible{:role => "alert"}
      = notice
      %button.btn-close{"data-bs-dismiss" => "alert", :type => "button"}
  - if alert
    .flash-alert.alert.alert-danger.alert-dismissible{:role => "alert"}
      = alert
      %button.btn-close{"data-bs-dismiss" => "alert", :type => "button"}

:javascript
  (function () {
    document.querySelectorAll('#flash-container .flash-alert').forEach(function (el) {
      setTimeout(function () {
        el.classList.add('fading');
        el.addEventListener('transitionend', function () { el.remove(); }, { once: true });
      }, 4000);
    });
  })();
