- if notice
  .alert.alert-success.alert-dismissible.fade.show.mx-3.mt-2{:role => "alert"}
    = notice
    %button.btn-close{"data-bs-dismiss" => "alert", :type => "button"}
- if alert
  .alert.alert-danger.alert-dismissible.fade.show.mx-3.mt-2{:role => "alert"}
    = alert
    %button.btn-close{"data-bs-dismiss" => "alert", :type => "button"}
