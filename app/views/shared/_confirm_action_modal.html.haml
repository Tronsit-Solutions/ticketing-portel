-# Confirm dialog shared by the Reset Password and Unlock buttons.
#confirmActionModal.modal.fade{"aria-labelledby" => "confirmActionModalLabel", "aria-hidden" => "true", tabindex: "-1"}
  .modal-dialog.modal-dialog-centered
    .modal-content
      .modal-header.border-0.pb-0
        %button.btn-close{"data-bs-dismiss" => "modal", "aria-label" => "Close", type: "button"}
      %form#confirmActionForm{method: "post", action: ""}
        = hidden_field_tag :_method, "patch"
        = hidden_field_tag :authenticity_token, form_authenticity_token
        .modal-body
          .text-center.mb-3
            %i.bi.bi-exclamation-triangle.text-warning{style: "font-size: 2.5rem;"}
            %p.mt-3.mb-0.fw-semibold#confirmActionMessage
        .modal-footer.border-0.pt-0.justify-content-center.gap-2
          %button.btn.btn-outline-secondary{"data-bs-dismiss" => "modal", type: "button"} Cancel
          %button#confirmActionSubmit.btn{type: "submit"} Confirm

:javascript
  document.getElementById('confirmActionModal').addEventListener('show.bs.modal', function(event) {
    var trigger = event.relatedTarget;
    var url = trigger.getAttribute('data-action-url');
    var message = trigger.getAttribute('data-action-message');
    var label = trigger.getAttribute('data-action-label');
    var btnClass = trigger.getAttribute('data-action-class');

    document.getElementById('confirmActionForm').setAttribute('action', url);
    document.getElementById('confirmActionMessage').textContent = message;

    var submitBtn = document.getElementById('confirmActionSubmit');
    submitBtn.textContent = label;
    submitBtn.className = 'btn ' + btnClass;
  });
