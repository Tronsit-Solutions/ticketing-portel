<h4 class="mb-4" style="font-family: Poppins;">Dashboard</h4>

<!-- Stat Cards -->
<div class="row g-3 mb-4">

  <div class="col-md-3">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="text-muted" style="font-size:13px;">Total Tickets</div>
        <div class="fs-3 fw-bold"><%= @total_tickets %></div>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="text-muted" style="font-size:13px;">Open</div>
        <div class="fs-3 fw-bold text-primary"><%= @open_tickets %></div>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="text-muted" style="font-size:13px;">In Progress</div>
        <div class="fs-3 fw-bold text-warning"><%= @in_progress %></div>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="text-muted" style="font-size:13px;">Unassigned</div>
        <div class="fs-3 fw-bold text-danger"><%= @unassigned %></div>
      </div>
    </div>
  </div>

</div>

<!-- Recent Tickets Table -->
<div class="card border-0 shadow-sm">
  <div class="card-header bg-white d-flex justify-content-between align-items-center">
    <span class="fw-bold">Recent Tickets</span>
    <%= link_to "View All", tickets_path, class: "btn btn-sm btn-outline-primary" %>
  </div>
  <div class="card-body p-0">
    <table class="table table-hover mb-0">
      <thead class="table-light">
        <tr>
          <th>#</th>
          <th>Title</th>
          <th>Type</th>
          <th>Status</th>
          <th>Customer</th>
          <th>Assignee</th>
          <th>Created</th>
        </tr>
      </thead>
      <tbody>
        <% @recent_tickets.each do |ticket| %>
          <tr>
            <td><%= ticket.id %></td>
            <td><%= link_to ticket.title, ticket_path(ticket), class: "text-dark text-decoration-none" %></td>
            <td><span class="badge bg-secondary"><%= ticket.ticket_type.humanize %></span></td>
            <td>
              <% color = { "open" => "primary", "in_progress" => "warning", "closed" => "success", "cancelled" => "danger" } %>
              <span class="badge bg-<%= color[ticket.status] %>"><%= ticket.status.humanize %></span>
            </td>
            <td><%= ticket.customer&.fullname || "-" %></td>
            <td><%= ticket.assignee&.fullname || "<span class='text-danger'>Unassigned</span>".html_safe %></td>
            <td><%= ticket.created_at.strftime("%b %d, %Y") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
