/ ── Page Header ─────────────────────────────────────────────────
.d-flex.justify-content-between.align-items-center.mb-4
  %div
    %h4.mb-0{style: "font-weight:700; color:#1a1a1a;"} Dashboard
    %small.text-muted= Date.today.strftime("%A, %B %-d, %Y")

/ ── Primary KPI Cards ───────────────────────────────────────────
.row.g-3.mb-3
  .col
    .card.border-0.shadow-sm.h-100
      .card-body.d-flex.align-items-center.gap-3
        .d-flex.align-items-center.justify-content-center.rounded-circle{style: "width:48px;height:48px;background:#e8f4fb;flex-shrink:0;"}
          %i.bi.bi-ticket-perforated-fill{style: "font-size:20px;color:#0077b6;"}
        %div
          %div{style: "font-size:11px;color:#6b7280;font-weight:600;text-transform:uppercase;letter-spacing:.05em;"} Total
          %div{style: "font-size:28px;font-weight:700;color:#1a1a1a;line-height:1.1;"}= @total_tickets
  .col
    .card.border-0.shadow-sm.h-100
      .card-body.d-flex.align-items-center.gap-3
        .d-flex.align-items-center.justify-content-center.rounded-circle{style: "width:48px;height:48px;background:#dbeafe;flex-shrink:0;"}
          %i.bi.bi-bookmark-fill{style: "font-size:20px;color:#1d4ed8;"}
        %div
          %div{style: "font-size:11px;color:#6b7280;font-weight:600;text-transform:uppercase;letter-spacing:.05em;"} Open
          %div{style: "font-size:28px;font-weight:700;color:#1d4ed8;line-height:1.1;"}= @open_tickets
  .col
    .card.border-0.shadow-sm.h-100
      .card-body.d-flex.align-items-center.gap-3
        .d-flex.align-items-center.justify-content-center.rounded-circle{style: "width:48px;height:48px;background:#fef3c7;flex-shrink:0;"}
          %i.bi.bi-arrow-repeat{style: "font-size:20px;color:#d97706;"}
        %div
          %div{style: "font-size:11px;color:#6b7280;font-weight:600;text-transform:uppercase;letter-spacing:.05em;"} In Progress
          %div{style: "font-size:28px;font-weight:700;color:#d97706;line-height:1.1;"}= @in_progress
  .col
    .card.border-0.shadow-sm.h-100
      .card-body.d-flex.align-items-center.gap-3
        .d-flex.align-items-center.justify-content-center.rounded-circle{style: "width:48px;height:48px;background:#fee2e2;flex-shrink:0;"}
          %i.bi.bi-inbox-fill{style: "font-size:20px;color:#dc2626;"}
        %div
          %div{style: "font-size:11px;color:#6b7280;font-weight:600;text-transform:uppercase;letter-spacing:.05em;"} Unassigned
          %div{style: "font-size:28px;font-weight:700;color:#dc2626;line-height:1.1;"}= @unassigned
  .col
    .card.border-0.shadow-sm.h-100
      .card-body.d-flex.align-items-center.gap-3
        .d-flex.align-items-center.justify-content-center.rounded-circle{style: "width:48px;height:48px;background:#dcfce7;flex-shrink:0;"}
          %i.bi.bi-check-circle-fill{style: "font-size:20px;color:#16a34a;"}
        %div
          %div{style: "font-size:11px;color:#6b7280;font-weight:600;text-transform:uppercase;letter-spacing:.05em;"} Closed
          %div{style: "font-size:28px;font-weight:700;color:#16a34a;line-height:1.1;"}= @closed_tickets

/ ── Secondary Stats ─────────────────────────────────────────────
.row.g-3.mb-4
  .col-md-4
    .card.border-0.shadow-sm
      .card-body.d-flex.align-items-center.gap-3
        .d-flex.align-items-center.justify-content-center.rounded-circle{style: "width:44px;height:44px;background:#ede9fe;flex-shrink:0;"}
          %i.bi.bi-headset{style: "font-size:18px;color:#7c3aed;"}
        %div
          %div{style: "font-size:11px;color:#6b7280;font-weight:600;text-transform:uppercase;letter-spacing:.05em;"} Active Agents
          %div{style: "font-size:22px;font-weight:700;color:#1a1a1a;"}= @total_agents
  .col-md-4
    .card.border-0.shadow-sm
      .card-body.d-flex.align-items-center.gap-3
        .d-flex.align-items-center.justify-content-center.rounded-circle{style: "width:44px;height:44px;background:#e0f2fe;flex-shrink:0;"}
          %i.bi.bi-people-fill{style: "font-size:18px;color:#0369a1;"}
        %div
          %div{style: "font-size:11px;color:#6b7280;font-weight:600;text-transform:uppercase;letter-spacing:.05em;"} Active Customers
          %div{style: "font-size:22px;font-weight:700;color:#1a1a1a;"}= @total_customers
  .col-md-4
    .card.border-0.shadow-sm
      .card-body.d-flex.align-items-center.gap-3
        .d-flex.align-items-center.justify-content-center.rounded-circle{style: "width:44px;height:44px;background:#fce7f3;flex-shrink:0;"}
          %i.bi.bi-calendar-check{style: "font-size:18px;color:#be185d;"}
        %div
          %div{style: "font-size:11px;color:#6b7280;font-weight:600;text-transform:uppercase;letter-spacing:.05em;"} Tickets Today
          %div{style: "font-size:22px;font-weight:700;color:#1a1a1a;"}= @tickets_today

/ ── Main Content ────────────────────────────────────────────────
.row.g-3
  / Recent Tickets
  .col-md-8
    .card.border-0.shadow-sm
      .card-header.bg-white.d-flex.justify-content-between.align-items-center
        %span.fw-bold Recent Tickets
        = link_to "View All →", tickets_path, class: "btn btn-sm btn-outline-primary"
      .card-body.p-0
        %table.table.table-hover.mb-0
          %thead.table-light
            %tr
              %th{style: "font-size:11px;text-transform:uppercase;letter-spacing:.05em;width:6%;"} #
              %th{style: "font-size:11px;text-transform:uppercase;letter-spacing:.05em;width:28%;"} Title
              %th{style: "font-size:11px;text-transform:uppercase;letter-spacing:.05em;width:14%;"} Status
              %th{style: "font-size:11px;text-transform:uppercase;letter-spacing:.05em;width:18%;"} Customer
              %th{style: "font-size:11px;text-transform:uppercase;letter-spacing:.05em;width:18%;"} Assignee
              %th{style: "font-size:11px;text-transform:uppercase;letter-spacing:.05em;width:16%;"} Date
          %tbody
            - @recent_tickets.each do |ticket|
              %tr
                %td{style: "font-size:12px;color:#9ca3af;"}= ticket.id
                %td
                  %span.tooltip-wrap{data: {tooltip: ticket.title}}
                    = link_to ticket.title, ticket_path(ticket), class: "text-dark text-decoration-none fw-semibold text-truncate-cell", style: "font-size:13px;"
                %td
                  - color = { "open" => "primary", "in_progress" => "warning", "closed" => "success", "cancelled" => "danger" }
                  %span{class: "badge bg-#{color[ticket.status]}", style: "font-size:11px;"}= ticket.status.humanize
                %td{style: "font-size:13px;"}
                  %span.tooltip-wrap{data: {tooltip: ticket.customer&.fullname}}
                    %span.text-truncate-cell= ticket.customer&.fullname || "-"
                %td{style: "font-size:13px;"}
                  - if ticket.assignee
                    %span.tooltip-wrap{data: {tooltip: ticket.assignee.fullname}}
                      %span.text-truncate-cell= ticket.assignee.fullname
                  - else
                    %span.text-danger Unassigned
                %td{style: "font-size:12px;color:#9ca3af;"}= ticket.created_at.strftime("%b %-d, %Y %-I:%M %p")

  / Right column
  .col-md-4

    / Tickets by Type
    .card.border-0.shadow-sm.mb-3
      .card-header.bg-white
        %span.fw-bold Tickets by Type
      .card-body.p-0
        - type_labels = Ticket::CATALOGUE.flat_map { |c| c[:children] || [c] }.each_with_object({}) { |c, h| h[c[:type]] = c[:label] }
        - total = @total_tickets.to_f
        - if @tickets_by_type.any?
          - @tickets_by_type.sort_by { |_, v| -v }.each do |type, count|
            .px-3.py-2.border-bottom
              .d-flex.justify-content-between.align-items-center.mb-1
                %span{style: "font-size:13px;"}= type_labels[type] || type.humanize
                %span.fw-semibold{style: "font-size:13px;"}= count
              .progress{style: "height:4px;border-radius:2px;"}
                .progress-bar.bg-primary{style: "width:#{total > 0 ? (count / total * 100).round : 0}%;", role: "progressbar"}
        - else
          .px-3.py-3.text-muted{style: "font-size:13px;"} No tickets yet.

    / Top Agents
    .card.border-0.shadow-sm
      .card-header.bg-white
        %span.fw-bold Top Agents
      .card-body.p-0
        - if @top_agents.any?
          - @top_agents.each_with_index do |agent, i|
            .d-flex.align-items-center.justify-content-between.px-3.py-2.border-bottom
              .d-flex.align-items-center.gap-2
                .d-flex.align-items-center.justify-content-center.rounded-circle.fw-bold{style: "width:30px;height:30px;background:#f3f4f6;color:#374151;font-size:12px;flex-shrink:0;"}= i + 1
                %span{style: "font-size:13px;"}= agent.fullname
              %span.badge.bg-primary.rounded-pill= agent.ticket_count
        - else
          .px-3.py-3.text-muted{style: "font-size:13px;"} No assigned tickets yet.
