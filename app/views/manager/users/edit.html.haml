.d-flex.justify-content-between.align-items-center.mb-4
  %h5.mb-0{:style => "font-family: Poppins;"} Edit Customer
  = link_to "Back", manager_users_path, class: "btn btn-outline-secondary btn-sm"

.card.border-0.shadow-sm{style: "max-width: 680px;"}
  .card-body.p-4
    = form_with model: @user, url: manager_user_path(@user), method: :patch, local: true do |f|
      - if @user.errors.any?
        .alert.alert-danger
          %ul.mb-0
            - @user.errors.full_messages.each do |msg|
              %li{:style => "font-size:13px;"}= msg
      .mb-3
        = f.label :fullname, "Full Name", class: "form-label fw-bold"
        = f.text_field :fullname, class: "form-control", placeholder: "Full name"
      .mb-3
        = f.label :email, class: "form-label fw-bold"
        = f.email_field :email, class: "form-control", placeholder: "Email address"
      .mb-3
        = f.label :contact_no, "Contact Number", class: "form-label fw-bold"
        = f.text_field :contact_no, class: "form-control", placeholder: "Contact number"
      .mb-3
        = f.label :address, class: "form-label fw-bold"
        = f.text_area :address, rows: 2, class: "form-control", placeholder: "Address"
      .form-check.mb-4
        = f.check_box :is_active, class: "form-check-input"
        = f.label :is_active, "Active account", class: "form-check-label"
      .d-flex.gap-2
        = f.submit "Save Changes", class: "btn btn-primary"
        = link_to "Cancel", manager_users_path, class: "btn btn-outline-secondary"
