- staff = @user.agent? || @user.manager?
= render "shared/user_profile",
  portal: :manager,
  profile_path: :manager_user_path,
  back_path: staff ? manager_teams_path : manager_users_path,
  back_label: staff ? "Teams" : "Customers",
  edit_url: manager_user_path(@user),
  reset_password_url: reset_password_manager_user_path(@user)
