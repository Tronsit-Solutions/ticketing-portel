- role_color = { "admin" => "danger", "agent" => "success", "manager" => "primary", "customer" => "secondary" }

- if @user.agent? || @user.manager?
  / ── Profile header banner ──────────────────────────
  .card.border-0.shadow-sm.mb-3
    .card-body.p-4
      .d-flex.align-items-center.gap-3
        .rounded-circle.d-flex.align-items-center.justify-content-center.flex-shrink-0{style: "width:64px; height:64px; background:#e7f1ff; color:#1565c0; font-size:24px; font-weight:700;"}
          = @user.fullname.first.upcase
        .flex-grow-1
          %h4.mb-1.fw-bold= "#{@user.fullname}'s Profile"
          .d-flex.align-items-center.gap-2
            %span{class: "badge bg-#{role_color[@user.role]}"}= @user.role.humanize
            - if @user.is_active?
              %span.badge.bg-success-subtle.text-success.border.border-success-subtle Active
            - else
              %span.badge.bg-secondary-subtle.text-secondary.border.border-secondary-subtle Inactive
            %span.text-muted.small
              %i.bi.bi-calendar3.me-1
              Joined= " #{@user.created_at.strftime('%B %d, %Y')}"
        %button.btn.btn-outline-primary.btn-sm{type: "button", "data-bs-toggle" => "modal", "data-bs-target" => "##{dom_id(@user, :edit)}"}
          %i.bi.bi-pencil-square.me-1
          Edit
        = link_to manager_teams_path, class: "btn btn-outline-secondary btn-sm" do
          %i.bi.bi-arrow-left.me-1
          Back

  .row.g-3

    / ── Left: Profile details ───────────────────────
    .col-md-4
      .card.border-0.shadow-sm
        .card-header.bg-white.fw-bold
          %i.bi.bi-person-lines-fill.me-2.text-primary
          Details
        .card-body
          .d-flex.align-items-start.gap-2.mb-3
            %i.bi.bi-envelope-fill.text-muted.mt-1
            .flex-grow-1
              %small.text-muted.d-block Email
              %div.fw-semibold= @user.email
          .d-flex.align-items-start.gap-2.mb-3
            %i.bi.bi-people-fill.text-muted.mt-1
            .flex-grow-1
              %small.text-muted.d-block Team
              %div.fw-semibold= @user.team&.name || "—"
          .d-flex.align-items-start.gap-2.mb-3
            %i.bi.bi-telephone-fill.text-muted.mt-1
            .flex-grow-1
              %small.text-muted.d-block Contact
              %div.fw-semibold= @user.contact_no.presence || "—"
          .d-flex.align-items-start.gap-2
            %i.bi.bi-geo-alt-fill.text-muted.mt-1
            .flex-grow-1
              %small.text-muted.d-block Address
              %div.fw-semibold= @user.address.presence || "—"

    / ── Right: Stats + Ticket history ──────────────
    .col-md-8

      / Stat cards
      .row.g-3.mb-3
        .col-4
          .card.border-0.shadow-sm.text-center.py-4
            %i.bi.bi-ticket-perforated-fill.text-warning.mb-2{style: "font-size:22px;"}
            .fs-3.fw-bold= @total_count
            %small.text-muted Total Tickets
        .col-4
          .card.border-0.shadow-sm.text-center.py-4
            %i.bi.bi-hourglass-split.text-primary.mb-2{style: "font-size:22px;"}
            .fs-3.fw-bold= @open_count
            %small.text-muted Active
        .col-4
          .card.border-0.shadow-sm.text-center.py-4
            %i.bi.bi-check-circle-fill.text-success.mb-2{style: "font-size:22px;"}
            .fs-3.fw-bold= @closed_count
            %small.text-muted Closed

      / Ticket history table
      .card.border-0.shadow-sm
        .card-header.bg-white.fw-bold
          %i.bi.bi-clock-history.me-2.text-primary
          Ticket History
        .card-body.p-0
        - if @assigned_tickets.any?
          %table.table.table-hover.mb-0
            %thead.table-light
              %tr
                %th{style: "width: 6%;"}= sortable_column_link(:manager_user_path, "#", "id", current_sort: @ticket_sort, current_direction: @ticket_direction, sort_param: :ticket_sort, direction_param: :ticket_direction, extra_params: request.query_parameters.merge(id: @user.id))
                %th{style: "width: 24%;"}= sortable_column_link(:manager_user_path, "Title", "title", current_sort: @ticket_sort, current_direction: @ticket_direction, sort_param: :ticket_sort, direction_param: :ticket_direction, extra_params: request.query_parameters.merge(id: @user.id))
                %th{style: "width: 11%;"} Type
                %th{style: "width: 11%;"}= sortable_column_link(:manager_user_path, "Status", "status", current_sort: @ticket_sort, current_direction: @ticket_direction, sort_param: :ticket_sort, direction_param: :ticket_direction, extra_params: request.query_parameters.merge(id: @user.id))
                %th{style: "width: 16%;"}= sortable_column_link(:manager_user_path, "Customer", "customer", current_sort: @ticket_sort, current_direction: @ticket_direction, sort_param: :ticket_sort, direction_param: :ticket_direction, extra_params: request.query_parameters.merge(id: @user.id))
                %th{style: "width: 14%;"} Created
                %th{style: "width: 10%;"} Resolution Time
                %th{style: "width: 8%;"}
            %tbody
              - color = { "open" => "primary", "in_progress" => "warning", "closed" => "success", "cancelled" => "danger" }
              - @assigned_tickets.each do |ticket|
                %tr
                  %td.text-muted{style: "font-size:13px;"}= "#{ticket.id}"
                  %td
                    %span.tooltip-wrap{data: {tooltip: ticket.title}}
                      = link_to ticket.title, ticket_path(ticket), class: "text-dark text-decoration-none text-truncate-cell"
                  %td
                    %span= ticket.type_label
                  %td
                    %span{class: "badge bg-#{color[ticket.status]}"}= ticket.status.humanize
                  %td
                    %span.tooltip-wrap{data: {tooltip: ticket.customer&.fullname}}
                      %span.text-truncate-cell= ticket.customer&.fullname || "-"
                  %td{style: "font-size:13px;"}= ticket.created_at&.strftime("%b %d, %Y %I:%M %p") || "-"
                  %td{style: "font-size:13px;"}= ticket.resolution_duration
                  %td= link_to "View", ticket_path(ticket), class: "btn btn-sm btn-outline-secondary"

          / Pagination controls
          .card-footer.bg-white.border-top-0.d-flex.justify-content-between.align-items-center.py-3.px-3
            .text-muted.small
              = page_entries_info @assigned_tickets
            .pagination-wrapper
              = paginate @assigned_tickets #, theme: 'bootstrap-5', pagination_class: "pagination-sm mb-0"
        - else
          .text-center.text-muted.py-5
            %i.bi.bi-ticket-perforated{style: "font-size: 2rem;"}
            %p.mt-2 No tickets found.

  = render "shared/user_edit_modal", user: @user, url: manager_user_path(@user)

- else
  / ── Simple profile for admin/customer ──────────────
  .d-flex.justify-content-between.align-items-center.mb-4
    %h5.mb-0.fw-bold= @user.fullname
    %button.btn.btn-sm.btn-outline-primary{type: "button", "data-bs-toggle" => "modal", "data-bs-target" => "##{dom_id(@user, :edit)}"} Edit

  .card.border-0.shadow-sm{style: "max-width: 680px;"}
    .card-header.bg-white.d-flex.justify-content-between.align-items-center
      %span.fw-bold= @user.fullname
      .d-flex.align-items-center.gap-2
        %span{class: "badge bg-#{role_color[@user.role]}"}= @user.role.humanize
        - if @user.customer?
          %button.btn.btn-sm.btn-outline-warning{type: "button", "data-bs-toggle" => "modal", "data-bs-target" => "#confirmActionModal", "data-action-url" => reset_password_manager_user_path(@user), "data-action-message" => "Reset #{@user.fullname}'s password to the default password?", "data-action-label" => "Reset Password", "data-action-class" => "btn-warning"} Reset Password
    .card-body
      .row.mb-3
        .col-md-4.text-muted Email
        .col-md-8= @user.email
      .row.mb-3
        .col-md-4.text-muted Team
        .col-md-8= @user.team&.name || "-"
      .row.mb-3
        .col-md-4.text-muted Contact
        .col-md-8= @user.contact_no || "-"
      .row.mb-3
        .col-md-4.text-muted Address
        .col-md-8= @user.address || "-"
      .row.mb-3
        .col-md-4.text-muted Status
        .col-md-8
          - if @user.is_active?
            %span.badge.bg-success Active
          - else
            %span.badge.bg-secondary Inactive
      .row.mb-3
        .col-md-4.text-muted Joined
        .col-md-8= @user.created_at.strftime("%B %d, %Y")
      - if @user.customer?
        %hr/
        .row.mb-3
          .col-md-4.text-muted Tickets Submitted
          .col-md-8= @user.customer_tickets.count
        .row.mb-3
          .col-md-4.text-muted Open Tickets
          .col-md-8= @user.customer_tickets.open.count

  = render "shared/user_edit_modal", user: @user, url: manager_user_path(@user)

  - if @user.customer?
    / ── Confirm Action Modal (Reset Password) ──
    #confirmActionModal.modal.fade{"aria-labelledby" => "confirmActionModalLabel", "aria-hidden" => "true", tabindex: "-1"}
      .modal-dialog.modal-dialog-centered
        .modal-content
          .modal-header.border-0.pb-0
            %button.btn-close{"data-bs-dismiss" => "modal", "aria-label" => "Close", type: "button"}
          %form#confirmActionForm{method: "post", action: ""}
            = hidden_field_tag :_method, "patch"
            = hidden_field_tag :authenticity_token, form_authenticity_token
            .modal-body
              .text-center.mb-3
                %i.bi.bi-exclamation-triangle.text-warning{style: "font-size: 2.5rem;"}
                %p.mt-3.mb-0.fw-semibold#confirmActionMessage
            .modal-footer.border-0.pt-0.justify-content-center.gap-2
              %button.btn.btn-outline-secondary{"data-bs-dismiss" => "modal", type: "button"} Cancel
              %button#confirmActionSubmit.btn{type: "submit"} Confirm

    :javascript
      document.getElementById('confirmActionModal').addEventListener('show.bs.modal', function(event) {
        var trigger = event.relatedTarget;
        var url = trigger.getAttribute('data-action-url');
        var message = trigger.getAttribute('data-action-message');
        var label = trigger.getAttribute('data-action-label');
        var btnClass = trigger.getAttribute('data-action-class');

        document.getElementById('confirmActionForm').setAttribute('action', url);
        document.getElementById('confirmActionMessage').textContent = message;

        var submitBtn = document.getElementById('confirmActionSubmit');
        submitBtn.textContent = label;
        submitBtn.className = 'btn ' + btnClass;
      });
