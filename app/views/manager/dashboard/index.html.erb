<h4 class="mb-4" style="font-family: Poppins;">Manager Dashboard</h4>

<!-- Stat Cards -->
<div class="row g-3 mb-4">

  <div class="col-md-4">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="text-muted" style="font-size:13px;">Total Tickets</div>
        <div class="fs-3 fw-bold"><%= @total_tickets %></div>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="text-muted" style="font-size:13px;">Open Tickets</div>
        <div class="fs-3 fw-bold text-primary"><%= @open_tickets %></div>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="text-muted" style="font-size:13px;">Closed Tickets</div>
        <div class="fs-3 fw-bold text-success"><%= @closed_tickets %></div>
      </div>
    </div>
  </div>

</div>

<!-- Agents in Team -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-white fw-bold">Agents in My Team</div>
  <div class="card-body p-0">
    <table class="table table-hover mb-0">
      <thead class="table-light">
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Active</th>
          <th>Assigned Tickets</th>
        </tr>
      </thead>
      <tbody>
        <% @agents.each do |agent| %>
          <tr>
            <td><%= agent.fullname %></td>
            <td><%= agent.email %></td>
            <td><%= agent.is_active? ? "Yes" : "No" %></td>
            <td><%= agent.assigned_tickets.in_progress.count %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
