%h4.mb-4{style: "font-family: Poppins;"} Manager Dashboard

/ ── Stat Cards ──────────────────────────────────────
.row.g-3.mb-4
  .col-md-3
    .card.border-0.shadow-sm
      .card-body
        .text-muted{style: "font-size:13px;"} All Tickets
        .fs-3.fw-bold= @total_tickets
  .col-md-3
    .card.border-0.shadow-sm
      .card-body
        .text-muted{style: "font-size:13px;"} Open Tickets
        .fs-3.fw-bold.text-primary= @open_tickets
  .col-md-3
    .card.border-0.shadow-sm
      .card-body
        .text-muted{style: "font-size:13px;"} Closed Tickets
        .fs-3.fw-bold.text-success= @closed_tickets
  .col-md-3
    .card.border-0.shadow-sm
      .card-body
        .text-muted{style: "font-size:13px;"} Team Agents
        .fs-3.fw-bold.text-info= @agents.count

/ ── Team Agents ─────────────────────────────────────
%h5.mb-3.mt-2{style: "font-family: Poppins;"} Team Agents

.row.g-3
  - @agents.each do |agent|
    .col-md-4
      = link_to manager_user_path(agent), class: "text-decoration-none" do
        .agent-card
          / Top row — avatar + name + status
          .d-flex.align-items-center.gap-3.mb-3
            .agent-avatar
              = agent.fullname.split.map(&:first).join.upcase.first(2)
            .flex-grow-1
              .fw-bold.text-dark{style: "font-size:15px;"}= agent.fullname
              %small.text-muted= agent.email
            - if agent.is_active
              %span.badge.bg-success.rounded-pill Active
            - else
              %span.badge.bg-secondary.rounded-pill Inactive

          / Stat row
          .d-flex.gap-2
            .agent-stat.flex-fill.text-center
              .agent-stat-value.text-warning= agent.assigned_tickets.in_progress.count
              .agent-stat-label In Progress
            .agent-stat.flex-fill.text-center
              .agent-stat-value.text-success= agent.assigned_tickets.closed.count
              .agent-stat-label Closed

:css
  .agent-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    padding: 20px;
    transition: box-shadow 0.15s, border-color 0.15s, transform 0.15s;
  }
  .agent-card:hover {
    box-shadow: 0 6px 20px rgba(0,0,0,0.10);
    border-color: #1565c0;
    transform: translateY(-2px);
  }
  .agent-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: linear-gradient(135deg, #1565c0, #1e88e5);
    color: #fff;
    font-size: 17px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    letter-spacing: 1px;
  }
  .agent-stat {
    background: #f8f9fa;
    border-radius: 10px;
    padding: 10px 6px;
  }
  .agent-stat-value {
    font-size: 20px;
    font-weight: 700;
    line-height: 1;
  }
  .agent-stat-label {
    font-size: 11px;
    color: #9ca3af;
    margin-top: 3px;
    font-weight: 500;
  }
