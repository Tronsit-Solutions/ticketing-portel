%h4.mb-4{:style => "font-family: Poppins;"} Manager Dashboard
/ Stat Cards
.row.g-3.mb-4
  .col-md-3
    .card.border-0.shadow-sm
      .card-body
        .text-muted{:style => "font-size:13px;"} All Tickets
        .fs-3.fw-bold= @total_tickets
  .col-md-3
    .card.border-0.shadow-sm
      .card-body
        .text-muted{:style => "font-size:13px;"} Open Tickets
        .fs-3.fw-bold.text-primary= @open_tickets
  .col-md-3
    .card.border-0.shadow-sm
      .card-body
        .text-muted{:style => "font-size:13px;"} Closed Tickets
        .fs-3.fw-bold.text-success= @closed_tickets
  .col-md-3
    .card.border-0.shadow-sm
      .card-body
        .text-muted{:style => "font-size:13px;"} Team Agents
        .fs-3.fw-bold.text-info= @agents.count

/ Agents Stats
%h5.mb-3{:style => "font-family: Poppins;"} Team Agents
.row.g-3
  - @agents.each do |agent|
    .col-md-4
      .card.border-0.shadow-sm
        .card-body
          .d-flex.justify-content-between.align-items-start.mb-3
            .d-flex.align-items-center.gap-2
              %i.bi.bi-person-circle{:style => "font-size:28px; color:#1565c0;"}
              %div
                %div.fw-bold= agent.fullname
                %small.text-muted= agent.email
            - if agent.is_active
              %span.badge.bg-success Active
            - else
              %span.badge.bg-secondary Inactive
          .border-top.pt-3
            .d-flex.justify-content-between.mb-2
              %span.text-muted Assigned Tickets
              %span.fw-bold.text-primary= agent.assigned_tickets.in_progress.count
            .d-flex.justify-content-between
              %span.text-muted Closed Tickets
              %span.fw-bold.text-success= agent.assigned_tickets.closed.count
