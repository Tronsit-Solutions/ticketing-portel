# HTTPS reverse proxy for the ticketing portal.
# Caddy serves https://10.10.10.24:3000 and forwards to Puma on 127.0.0.1:3001.
#
# Start Puma:  ruby bin\rails server -b 127.0.0.1 -p 3001 -e production
# Start Caddy: caddy run --config config\Caddyfile   (from the project root)
# Server .env: ASSUME_SSL=true  (and no FORCE_SSL=false)

{
	servers {
		# Redirect plain http://10.10.10.24:3000 to https:// on the same port
		# instead of failing with "HTTP request to an HTTPS server".
		listener_wrappers {
			http_redirect
			tls
		}
	}
}

# --- Now: internal IP, certificate issued by Caddy's own local CA ---
https://10.10.10.24:3000 {
	tls internal
	reverse_proxy 127.0.0.1:3001
}

# --- Later: public domain, free Let's Encrypt certificate (auto-renewed) ---
# Add this once DNS points at the server and ports 80 and 443 are open
# from the internet; it is then reached at https://portal.example.com.
#
# portal.example.com {
# 	reverse_proxy 127.0.0.1:3001
# }
